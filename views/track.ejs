          <line x1="6" y1="46" x2="32" y2="46" stroke="#334155" stroke-width="1.2"/>
          <line x1="6" y1="54" x2="32" y2="54" stroke="#334155" stroke-width="1.2"/>
          <line x1="6" y1="62" x2="32" y2="62" stroke="#334155" stroke-width="1.2"/>
          <line x1="6" y1="70" x2="32" y2="70" stroke="#334155" stroke-width="1.2"/>
