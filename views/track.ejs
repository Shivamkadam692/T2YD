        <!-- Windshield -->
        <path d="M 8,11 C 10,6 14,5 19,5 C 24,5 28,6 30,11 L 29,18 C 24,15 14,15 9,18 Z" fill="#0f172a" opacity="0.88"/>
        <path d="M 12,8 Q 19,6 26,8" stroke="#38bdf8" stroke-width="1" stroke-linecap="round" opacity="0.65"/>
        <!-- Roof Spoiler / Sun Visor -->
        <rect x="9" y="19" width="20" height="7" rx="1.5" fill="#ea580c"/>
