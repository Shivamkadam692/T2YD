        <rect x="4" y="30" width="30" height="46" rx="2.5" fill="#1e293b" stroke="#f97316" stroke-width="1.5"/>
        <line x1="6" y1="36" x2="32" y2="36" stroke="#334155" stroke-width="1.2"/>
        <line x1="6" y1="42" x2="32" y2="42" stroke="#334155" stroke-width="1.2"/>
        <line x1="6" y1="48" x2="32" y2="48" stroke="#334155" stroke-width="1.2"/>
        <line x1="6" y1="54" x2="32" y2="54" stroke="#334155" stroke-width="1.2"/>
        <line x1="6" y1="60" x2="32" y2="60" stroke="#334155" stroke-width="1.2"/>
        <line x1="6" y1="66" x2="32" y2="66" stroke="#334155" stroke-width="1.2"/>
