}

/* ==========================================================================
   3. REALISTIC TOP-VIEW TRUCK ICONS (DIRECT FROM ABOVE)
   ========================================================================== */
.t2yd-truck-marker {
  position: relative;
  width: 44px;
  height: 92px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  pointer-events: auto;
}

/* Rotating chassis container around exact center */
.truck-chassis-rotator {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 38px;
  height: 84px;
  margin-top: -42px;
  margin-left: -19px;
  transform-origin: 50% 50%;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Moving Radar Pulse Wave (Radiating from vehicle center) */
.truck-radar-wave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 50px;
  height: 50px;
  margin-top: -25px;
  margin-left: -25px;
  border-radius: 50%;
  border: 2px solid #22c55e;
  opacity: 0;
  pointer-events: none;
}

.t2yd-truck-marker.is-moving .truck-radar-wave {
  animation: truckRadarPulse 1.8s ease-out infinite;
}

@keyframes truckRadarPulse {
  0% { transform: scale(0.6); opacity: 0.9; }
  100% { transform: scale(1.6); opacity: 0; }
}

/* Selection Beacon Halo */
.t2yd-truck-marker.is-selected .truck-chassis-rotator::after {
  content: '';
  position: absolute;
  top: -6px;
  left: -6px;
  right: -6px;
  bottom: -6px;
  border-radius: 8px;
  border: 2.5px solid var(--t2yd-saffron);
  box-shadow: 0 0 16px rgba(234, 88, 12, 0.6);
  pointer-events: none;
  animation: selectionGlow 1.6s ease-in-out infinite alternate;
}

@keyframes selectionGlow {
  0% { opacity: 0.6; transform: scale(0.98); }
  100% { opacity: 1; transform: scale(1.03); }
}

/* Offline / Stale state */
.t2yd-truck-marker.is-stale .truck-svg {
  filter: grayscale(80%) opacity(0.75);
}

