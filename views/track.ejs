          <path d="M 8,11 C 10,6 14,5 19,5 C 24,5 28,6 30,11 L 29,18 C 24,15 14,15 9,18 Z" fill="#0f172a" opacity="0.85"/>
          <!-- Mirrors -->
          <path d="M 6,14 L 1,12 L 1,17 L 6,16 Z" fill="#0f172a"/>
