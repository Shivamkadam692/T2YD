  // 4. Mathematical Bearing Calculation Helper
  function calculateBearing(lat1, lon1, lat2, lon2) {
    const toRad = deg => deg * Math.PI / 180;
    const toDeg = rad => rad * 180 / Math.PI;
    const dLon = toRad(lon2 - lon1);
    const y = Math.sin(dLon) * Math.cos(toRad(lat2));
    const x = Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) - Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(dLon);
    const brng = toDeg(Math.atan2(y, x));
    return (brng + 360) % 360;
  }

  // Haversine Distance in Kilometers
  function haversineKm(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const toRad = d => d * Math.PI / 180;
    const dLat = toRad(lat2 - lat1);
    const dLng = toRad(lon2 - lon1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // 5. Fleet Truck Marker Registry
  // Map of requestId -> { marker, rotatorEl, heading, lat, lng, lastUpdated, vehicleType }
  const truckMarkers = new Map();
  let pickupMarker = null;
  let dropMarker = null;
  let activeRoadPolyline = null;
  let activeRoadCasing = null;
  let routeToPickupPolyline = null;

  // Create DivIcon for a truck
  function createTruckLeafletIcon(req) {
    const lorry = req.lorry || {};
    const lorryNum = lorry.vehicleNumber || 'TRUCK';
    const vehicleType = lorry.vehicleType || 'Tata 28T';
    const svgHTML = generateTopViewTruckSVG({ vehicleType });

    const html = `
      <div class="t2yd-truck-marker" id="marker-wrap-${req.id}">
        <div class="truck-radar-wave"></div>
        <div class="truck-chassis-rotator" id="rotator-${req.id}">
          ${svgHTML}
        </div>
        <div class="truck-plate-tag">
          <span class="plate-status-dot live"></span>
          <span>${lorryNum}</span>
        </div>
      </div>
    `;

    return L.divIcon({
      className: 't2yd-leaflet-truck-container',
      html: html,
      iconSize: [44, 92],
      iconAnchor: [22, 46] // Exact center anchor!
    });
  }

  // Create Waypoint Markers (Pickup / Drop)
  function createWaypointIcon(type, title) {
    const isPickup = type === 'pickup';
    const iconClass = isPickup ? 'fa-warehouse' : 'fa-flag-checkered';
    const html = `
      <div class="t2yd-waypoint-marker">
        <div class="waypoint-pin ${isPickup ? 'pickup' : 'drop'}">
          <i class="fas ${iconClass}"></i>
        </div>
        <div class="waypoint-label-pill">${title}</div>
      </div>
    `;
    return L.divIcon({
      className: 't2yd-leaflet-waypoint-container',
      html: html,
      iconSize: [36, 48],
      iconAnchor: [18, 24]
    });
  }

  // 6. Smooth GPS Movement Animation
  function animateMarkerGlide(marker, startLL, endLL, duration = 800) {
    const startTime = performance.now();
    function step(now) {
      const elapsed = now - startTime;
      const t = Math.min(1, elapsed / duration);
      // Cubic ease out
      const ease = 1 - Math.pow(1 - t, 3);
      const curLat = startLL.lat + (endLL.lat - startLL.lat) * ease;
      const curLng = startLL.lng + (endLL.lng - startLL.lng) * ease;
      marker.setLatLng([curLat, curLng]);
      if (t < 1) {
        requestAnimationFrame(step);
      }
    }
    requestAnimationFrame(step);
  }

  // 7. Update or Create Truck Marker
  function updateTruckMarker(reqId, lat, lng, heading = null, speed = null) {
    if (lat == null || lng == null || isNaN(lat) || isNaN(lng)) return;

    let truckObj = truckMarkers.get(reqId);
    const req = activeRequests.find(r => String(r.id) === String(reqId)) || activeTruckData;
    if (!req) return;

    if (!truckObj) {
      // Create new marker
      const icon = createTruckLeafletIcon(req);
      const marker = L.marker([lat, lng], {
        icon: icon,
        title: req.lorry ? req.lorry.vehicleNumber : 'Truck'
      }).addTo(map);

      // Click event opens card and focuses
      marker.on('click', () => {
        selectActiveTruck(reqId, true);
      });

      truckObj = {
        marker,
        rotatorEl: null,
        lat,
        lng,
        heading: heading != null ? heading : 0,
        speed: speed != null ? speed : 0,
        lastUpdated: Date.now(),
        req
      };
      truckMarkers.set(reqId, truckObj);

      // Query rotator DOM after Leaflet adds it
      setTimeout(() => {
        const wrap = document.getElementById(`marker-wrap-${reqId}`);
        if (wrap) {
          truckObj.rotatorEl = wrap.querySelector('.truck-chassis-rotator');
          if (heading != null) {
            truckObj.rotatorEl.style.transform = `rotate(${heading}deg)`;
          }
        }
      }, 50);
    } else {
      // Marker exists: smooth animation and bearing calculation
      const oldLat = truckObj.lat;
      const oldLng = truckObj.lng;

      // Calculate bearing if movement detected
      let newHeading = heading;
      const movedDistance = haversineKm(oldLat, oldLng, lat, lng) * 1000; // in meters
      if (newHeading == null && movedDistance > 3) {
        newHeading = calculateBearing(oldLat, oldLng, lat, lng);
      }

      // Smooth coordinate glide
      animateMarkerGlide(truckObj.marker, { lat: oldLat, lng: oldLng }, { lat, lng }, 800);

      truckObj.lat = lat;
      truckObj.lng = lng;
      truckObj.lastUpdated = Date.now();
      if (speed != null) truckObj.speed = speed;

      // Rotate Top-View Truck around its center
      if (newHeading != null) {
        truckObj.heading = newHeading;
        if (!truckObj.rotatorEl) {
          const wrap = document.getElementById(`marker-wrap-${reqId}`);
          if (wrap) truckObj.rotatorEl = wrap.querySelector('.truck-chassis-rotator');
        }
        if (truckObj.rotatorEl) {
          truckObj.rotatorEl.style.transform = `rotate(${newHeading}deg)`;
        }
      }

      // Update movement state class
      const wrap = document.getElementById(`marker-wrap-${reqId}`);
      if (wrap) {
        if (movedDistance > 2 || (speed != null && speed > 2)) {
          wrap.classList.add('is-moving');
          wrap.classList.remove('is-stale');
        } else {
          wrap.classList.remove('is-moving');
        }
      }
    }

    // If this truck is selected, update details card & recenter
    if (activeTruckData && String(activeTruckData.id) === String(reqId)) {
      updateInfoCardTelemetry(truckObj);
    }
  }

  // 8. OSRM Road Routing
  async function fetchOSRMRoute(fromLL, toLL) {
    try {
      const url = `https://router.project-osrm.org/route/v1/driving/${fromLL.lng},${fromLL.lat};${toLL.lng},${toLL.lat}?overview=full&geometries=geojson`;
      const res = await fetch(url);
      if (!res.ok) return null;
      const data = await res.json();
      if (data && data.routes && data.routes.length > 0) {
        return data.routes[0];
      }
    } catch (e) {
      console.warn('OSRM routing unavailable, fallback to direct path', e);
    }
    return null;
  }

  function clearActiveRoutes() {
    if (activeRoadCasing) { map.removeLayer(activeRoadCasing); activeRoadCasing = null; }
    if (activeRoadPolyline) { map.removeLayer(activeRoadPolyline); activeRoadPolyline = null; }
    if (routeToPickupPolyline) { map.removeLayer(routeToPickupPolyline); routeToPickupPolyline = null; }
  }

  async function drawHighwayRoute(pickupLL, dropLL, truckLL = null) {
    clearActiveRoutes();
    if (!pickupLL || !dropLL) return;

    const osrmRoute = await fetchOSRMRoute(pickupLL, dropLL);
    let coords = [];

    if (osrmRoute && osrmRoute.geometry && osrmRoute.geometry.coordinates) {
      coords = osrmRoute.geometry.coordinates.map(([lng, lat]) => [lat, lng]);
    } else {
      coords = [[pickupLL.lat, pickupLL.lng], [dropLL.lat, dropLL.lng]];
    }

    // Outer dark casing (road pavement)
    activeRoadCasing = L.polyline(coords, {
      color: '#0f172a',
      weight: 7,
      opacity: 0.85,
      lineCap: 'round',
      lineJoin: 'round'
    }).addTo(map);

    // Inner bright T2YD highway stroke
    activeRoadPolyline = L.polyline(coords, {
      color: '#ea580c',
      weight: 4.5,
      opacity: 0.95,
      lineCap: 'round',
      lineJoin: 'round'
    }).addTo(map);

    // If truck is navigating to pickup, draw distinct amber dashed connector
    if (truckLL && (!activeTruckData.loadedAt)) {
      const toPickupRoute = await fetchOSRMRoute(truckLL, pickupLL);
      const toPickupCoords = (toPickupRoute && toPickupRoute.geometry)
        ? toPickupRoute.geometry.coordinates.map(([lng, lat]) => [lat, lng])
        : [[truckLL.lat, truckLL.lng], [pickupLL.lat, pickupLL.lng]];

      routeToPickupPolyline = L.polyline(toPickupCoords, {
        color: '#f59e0b',
        weight: 3.5,
        dashArray: '6, 8',
        opacity: 0.9
      }).addTo(map);
    }
  }

  // 9. Geocoding Resolver for Pickup & Drop
  async function resolveCoordinates(query) {
    if (!query) return null;
    try {
      const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`;
      const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
      const list = await res.json();
      if (list && list.length > 0) {
        return { lat: parseFloat(list[0].lat), lng: parseFloat(list[0].lon) };
      }
    } catch (e) {
      console.warn('Geocoding error for query:', query, e);
    }
    return null;
  }

  // 10. Fit All Map Bounds
  function fitFleetBounds() {
    let bounds = null;
    const addLL = (ll) => {
      if (!ll || ll.lat == null || ll.lng == null) return;
      if (!bounds) bounds = L.latLngBounds([ll]);
      else bounds.extend(ll);
    };

    truckMarkers.forEach(t => addLL({ lat: t.lat, lng: t.lng }));
    if (pickupMarker) addLL(pickupMarker.getLatLng());
    if (dropMarker) addLL(dropMarker.getLatLng());
    if (activeRoadPolyline) bounds = bounds ? bounds.extend(activeRoadPolyline.getBounds()) : activeRoadPolyline.getBounds();

    if (bounds && bounds.isValid()) {
      map.fitBounds(bounds, { padding: [60, 60], maxZoom: 15 });
    }
  }

  // 11. Select Active Truck & Load Route
  async function selectActiveTruck(reqId, recenter = false) {
    const req = activeRequests.find(r => String(r.id) === String(reqId)) || activeTruckData;
    if (!req) return;

    activeTruckData = req;
    currentRequestId = req.id;

    // Highlight in list
    document.querySelectorAll('.fleet-truck-card').forEach(c => {
      c.classList.toggle('active', c.dataset.requestId === String(reqId));
    });

    // Update markers visual state
    truckMarkers.forEach((t, id) => {
      const wrap = document.getElementById(`marker-wrap-${id}`);
      if (wrap) wrap.classList.toggle('is-selected', String(id) === String(reqId));
    });

    // Resolve Waypoints
    let pLL = req.exactPickup && req.exactPickup.lat ? { lat: req.exactPickup.lat, lng: req.exactPickup.lng } : null;
    let dLL = req.exactDrop && req.exactDrop.lat ? { lat: req.exactDrop.lat, lng: req.exactDrop.lng } : null;

    if (!pLL && req.delivery && req.delivery.pickupLocation) {
      pLL = await resolveCoordinates(req.delivery.pickupLocation);
    }
    if (!dLL && req.delivery && req.delivery.dropLocation) {
      dLL = await resolveCoordinates(req.delivery.dropLocation);
    }

    // Waypoint Markers
    if (pickupMarker) map.removeLayer(pickupMarker);
    if (dropMarker) map.removeLayer(dropMarker);

    if (pLL) {
      const pLabel = (req.delivery && req.delivery.pickupLocation) ? req.delivery.pickupLocation.split(',')[0] : 'Pickup';
      pickupMarker = L.marker([pLL.lat, pLL.lng], { icon: createWaypointIcon('pickup', pLabel) }).addTo(map);
    }
    if (dLL) {
      const dLabel = (req.delivery && req.delivery.dropLocation) ? req.delivery.dropLocation.split(',')[0] : 'Drop';
      dropMarker = L.marker([dLL.lat, dLL.lng], { icon: createWaypointIcon('drop', dLabel) }).addTo(map);
    }

    // Get current truck coords
    const truckObj = truckMarkers.get(reqId);
    const truckLL = truckObj ? { lat: truckObj.lat, lng: truckObj.lng } : null;

    // Draw Route
    if (pLL && dLL) {
      await drawHighwayRoute(pLL, dLL, truckLL);
    }

    // Populate and show Information Card
    populateInfoCard(req, truckObj, pLL, dLL);

    if (recenter) {
      if (truckObj) {
        map.setView([truckObj.lat, truckObj.lng], 15, { animate: true });
      } else if (pLL && dLL) {
        fitFleetBounds();
      }
    }
  }

  // 12. Information Card UI Population
  function populateInfoCard(req, truckObj, pLL, dLL) {
    const dock = document.getElementById('truckInfoCardDock');
    if (!dock) return;

    dock.style.display = 'block';

    const lorry = req.lorry || {};
    const lorryNum = lorry.vehicleNumber || 'MH-12-Q-4521';
    const vehicleType = lorry.vehicleType || 'Tata 28T';
    const driverName = (req.transporter && req.transporter.name) ? req.transporter.name : 'Transporter Driver';
    const driverPhone = (req.transporter && req.transporter.phone) ? req.transporter.phone : '';

    const pText = req.delivery ? (req.delivery.pickupLocation || 'Pickup Hub') : 'Pickup Hub';
    const dText = req.delivery ? (req.delivery.dropLocation || 'Destination') : 'Destination';

    document.getElementById('cardTruckPlate').textContent = lorryNum;
    document.getElementById('cardTruckType').textContent = vehicleType;
    document.getElementById('cardDriverName').textContent = driverName;
    document.getElementById('cardPickupText').textContent = pText;
    document.getElementById('cardDropText').textContent = dText;

    const callBtn = document.getElementById('cardCallBtn');
    if (callBtn) {
      if (driverPhone) {
        callBtn.href = `tel:${driverPhone}`;
        callBtn.style.display = 'inline-flex';
      } else {
        callBtn.style.display = 'none';
      }
    }

    // Details button
    const detailsBtn = document.getElementById('viewShipmentDetailsBtn');
    if (detailsBtn) {
      detailsBtn.href = `/dashboard/${role === 'shipper' ? 'shipper' : 'transporter'}`;
    }

    // External Google Maps Navigation link
    const gmapsBtn = document.getElementById('googleMapsExternalBtn');
    if (gmapsBtn && pLL && dLL) {
      const origin = truckObj ? `${truckObj.lat},${truckObj.lng}` : `${pLL.lat},${pLL.lng}`;
      gmapsBtn.href = `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${dLL.lat},${dLL.lng}&waypoints=${pLL.lat},${pLL.lng}&travelmode=driving`;
      gmapsBtn.style.display = 'inline-flex';
    } else if (gmapsBtn) {
      gmapsBtn.style.display = 'none';
    }

    // Loaded photo check
    const shipperPhotoBox = document.getElementById('shipperPhotoBox');
    if (shipperPhotoBox) {
      if (req.loadedPhoto) {
        shipperPhotoBox.style.display = 'block';
        document.getElementById('shipperGoodsPhotoImg').src = req.loadedPhoto;
      } else {
        shipperPhotoBox.style.display = 'none';
      }
    }

    updateInfoCardTelemetry(truckObj, pLL, dLL);
  }

  function updateInfoCardTelemetry(truckObj, pLL = null, dLL = null) {
    if (!truckObj) return;

    // Speed display
    const speedEl = document.getElementById('cardSpeedVal');
    if (speedEl) {
      if (truckObj.speed != null && truckObj.speed > 0) {
        speedEl.textContent = `${Math.round(truckObj.speed)} km/h`;
      } else {
        speedEl.textContent = 'Stationary';
      }
    }

    // Last GPS timestamp
    const lastGpsEl = document.getElementById('cardLastGpsVal');
    if (lastGpsEl && truckObj.lastUpdated) {
      const diffSec = Math.floor((Date.now() - truckObj.lastUpdated) / 1000);
      if (diffSec < 10) lastGpsEl.textContent = 'Just now';
      else if (diffSec < 60) lastGpsEl.textContent = `${diffSec}s ago`;
      else lastGpsEl.textContent = `${Math.floor(diffSec / 60)}m ago`;
    }

    // Distance calculation
    const distEl = document.getElementById('cardDistanceVal');
    if (distEl && pickupMarker && dropMarker) {
      const km = haversineKm(pickupMarker.getLatLng().lat, pickupMarker.getLatLng().lng, dropMarker.getLatLng().lat, dropMarker.getLatLng().lng);
      distEl.textContent = `${km.toFixed(1)} km`;
    }
  }

  // 13. Seed Known Positions from Database on Page Load
  activeRequests.forEach(r => {
    const tLoc = r.transporterLocation;
    if (tLoc && tLoc.lat != null && tLoc.lng != null) {
      updateTruckMarker(r.id, tLoc.lat, tLoc.lng, tLoc.heading || null, tLoc.speed || null);
    }
  });

  // Load primary active truck
  if (activeTruckData) {
    selectActiveTruck(activeTruckData.id, false).then(() => {
      fitFleetBounds();
    });
  }

  // 14. Real-Time Socket.IO Integration
  const socket = (typeof io !== 'undefined') ? io() : null;
  const connectionStatus = document.getElementById('connectionStatus');

  if (socket) {
    socket.on('connect', () => {
      if (connectionStatus) {
        connectionStatus.className = 'status-pill connected';
        connectionStatus.querySelector('.status-label').textContent = 'GPS Live Connected';
      }

      // Join rooms for all active requests
      activeRequests.forEach(r => {
        socket.emit('join', { requestId: r.id });
      });
      if (activeTruckData) {
        socket.emit('join', { requestId: activeTruckData.id });
      }
    });

    socket.on('disconnect', () => {
      if (connectionStatus) {
        connectionStatus.className = 'status-pill offline';
        connectionStatus.querySelector('.status-label').textContent = 'Offline (Reconnecting)';
      }
    });

    socket.on('reconnecting', () => {
      if (connectionStatus) {
        connectionStatus.className = 'status-pill connecting';
        connectionStatus.querySelector('.status-label').textContent = 'Reconnecting...';
      }
    });

    // Real-Time Location Update Handler
    socket.on('locationUpdate', (payload) => {
      if (!payload) return;
      const { requestId: reqId, role: senderRole, lat, lng, heading, speed } = payload;
      
      // Update the top-view truck marker on the map!
      if (senderRole !== 'shipper') {
        updateTruckMarker(reqId || currentRequestId, lat, lng, heading, speed);
      }
    });
  }

  // 15. Transporter Live GPS Broadcasting
  let geolocationWatchId = null;
  let prevBroadcastingCoord = null;
  const shareBtn = document.getElementById('liveShareToggleBtn');
  const gpsStreamPill = document.getElementById('gpsStreamPill');

  function startLiveGPSBroadcasting() {
    if (!navigator.geolocation) {
      alert('Geolocation is not supported by your browser');
      return;
    }

    if (geolocationWatchId !== null) return;

    if (shareBtn) {
      shareBtn.className = 'tool-btn share-active';
      shareBtn.innerHTML = '<i class="fas fa-stop-circle"></i> <span>Stop Sharing GPS</span>';
    }
    if (gpsStreamPill) gpsStreamPill.style.display = 'inline-flex';

    const geoOptions = {
      enableHighAccuracy: true,
      maximumAge: 5000,
      timeout: 10000
    };

    geolocationWatchId = navigator.geolocation.watchPosition(
      (pos) => {
        const { latitude: lat, longitude: lng, heading: rawHeading, speed: rawSpeed } = pos.coords;
        let heading = rawHeading;
        let speed = rawSpeed != null ? rawSpeed * 3.6 : null; // Convert m/s to km/h

        if ((heading == null || isNaN(heading)) && prevBroadcastingCoord) {
          heading = calculateBearing(prevBroadcastingCoord.lat, prevBroadcastingCoord.lng, lat, lng);
        }
        prevBroadcastingCoord = { lat, lng };

        if (socket && currentRequestId) {
          socket.emit('locationUpdate', {
            requestId: currentRequestId,
            role: 'transporter',
            lat,
            lng,
            heading,
            speed
          });
        }

        // Locally update marker immediately
        updateTruckMarker(currentRequestId, lat, lng, heading, speed);
      },
      (err) => {
        console.warn('Geolocation broadcast warning:', err);
      },
      geoOptions
    );
  }

  function stopLiveGPSBroadcasting() {
    if (geolocationWatchId !== null) {
      navigator.geolocation.clearWatch(geolocationWatchId);
      geolocationWatchId = null;
    }
    if (shareBtn) {
      shareBtn.className = 'tool-btn share-stopped';
      shareBtn.innerHTML = '<i class="fas fa-location-arrow"></i> <span>Share My GPS</span>';
    }
    if (gpsStreamPill) gpsStreamPill.style.display = 'none';

    if (socket && currentRequestId) {
      socket.emit('stopTracking', { requestId: currentRequestId, role: 'transporter' });
    }
  }

  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      if (geolocationWatchId === null) {
        startLiveGPSBroadcasting();
      } else {
        stopLiveGPSBroadcasting();
      }
    });
  }

  window.addEventListener('beforeunload', () => {
    stopLiveGPSBroadcasting();
  });

  // 16. Transporter Mark Pickup & Photo Upload
  const pickPhotoBtn = document.getElementById('pickPhotoBtn');
  const transporterPhotoInput = document.getElementById('transporterPhotoInput');
  const markLoadedActionBtn = document.getElementById('markLoadedActionBtn');
  let selectedLoadedPhotoFile = null;

  if (pickPhotoBtn && transporterPhotoInput) {
    pickPhotoBtn.addEventListener('click', () => transporterPhotoInput.click());
    transporterPhotoInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        selectedLoadedPhotoFile = file;
        const reader = new FileReader();
        reader.onload = (ev) => {
          document.getElementById('loadedPreviewImg').src = ev.target.result;
          document.getElementById('loadedPhotoPreviewBox').style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (markLoadedActionBtn) {
    markLoadedActionBtn.addEventListener('click', async () => {
      if (!currentRequestId) return;
      markLoadedActionBtn.disabled = true;
      markLoadedActionBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';

      const formData = new FormData();
      if (selectedLoadedPhotoFile) {
        formData.append('loadedPhoto', selectedLoadedPhotoFile);
      }

      try {
        const res = await fetch(`/dashboard/requests/${currentRequestId}/mark-loaded`, {
          method: 'POST',
          body: formData
        });
        if (res.ok) {
          alert('Pickup successfully marked and goods verified!');
          document.getElementById('transporterMarkLoadedBox').style.display = 'none';
        } else {
          alert('Failed to mark pickup. Please try again.');
          markLoadedActionBtn.disabled = false;
          markLoadedActionBtn.innerHTML = '<i class="fas fa-check-circle"></i> Mark Pickup Loaded';
        }
      } catch (err) {
        console.error(err);
        alert('Network error while marking pickup.');
        markLoadedActionBtn.disabled = false;
        markLoadedActionBtn.innerHTML = '<i class="fas fa-check-circle"></i> Mark Pickup Loaded';
      }
    });
  }

  // 17. Toolbar Control Handlers
  const recenterBtn = document.getElementById('recenterTruckBtn');
  if (recenterBtn) {
    recenterBtn.addEventListener('click', () => {
      if (activeTruckData) {
        const truckObj = truckMarkers.get(activeTruckData.id);
        if (truckObj) {
          map.setView([truckObj.lat, truckObj.lng], 16, { animate: true });
        } else {
          fitFleetBounds();
        }
      }
    });
  }

  const fitBoundsBtn = document.getElementById('fitRouteBoundsBtn');
  if (fitBoundsBtn) {
    fitBoundsBtn.addEventListener('click', () => {
      fitFleetBounds();
    });
  }

  // Toggle Fleet Panel
  const toggleFleetPanelBtn = document.getElementById('toggleFleetPanelBtn');
  const floatingFleetPanel = document.getElementById('floatingFleetPanel');
  const closeFleetPanelBtn = document.getElementById('closeFleetPanelBtn');

  function setFleetPanelVisible(visible) {
    if (!floatingFleetPanel) return;
    floatingFleetPanel.classList.toggle('collapsed', !visible);
    if (toggleFleetPanelBtn) toggleFleetPanelBtn.classList.toggle('active', visible);
  }

  if (toggleFleetPanelBtn) {
    toggleFleetPanelBtn.addEventListener('click', () => {
      const isCurrentlyCollapsed = floatingFleetPanel.classList.contains('collapsed');
      setFleetPanelVisible(isCurrentlyCollapsed);
    });
  }
  if (closeFleetPanelBtn) {
    closeFleetPanelBtn.addEventListener('click', () => setFleetPanelVisible(false));
  }

  // Toggle Legend
  const toggleLegendBtn = document.getElementById('toggleLegendBtn');
  const floatingLegendBox = document.getElementById('floatingLegendBox');
  if (toggleLegendBtn && floatingLegendBox) {
    toggleLegendBtn.addEventListener('click', () => {
      const isVisible = floatingLegendBox.style.display !== 'none';
      floatingLegendBox.style.display = isVisible ? 'none' : 'flex';
      toggleLegendBtn.classList.toggle('active', !isVisible);
    });
  }

  // Close Info Card
  const closeInfoCardBtn = document.getElementById('closeInfoCardBtn');
  if (closeInfoCardBtn) {
    closeInfoCardBtn.addEventListener('click', () => {
      document.getElementById('truckInfoCardDock').style.display = 'none';
    });
  }

  // Fleet Search Filter
  const fleetSearchInput = document.getElementById('fleetSearchInput');
  if (fleetSearchInput) {
    fleetSearchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      document.querySelectorAll('.fleet-truck-card').forEach(card => {
        const text = card.textContent.toLowerCase();
        card.style.display = text.includes(q) ? 'flex' : 'none';
      });
    });
  }

  // Truck Card Selection Click in Panel
  document.querySelectorAll('.fleet-truck-card').forEach(card => {
    card.addEventListener('click', () => {
      const reqId = card.dataset.requestId;
      if (reqId) selectActiveTruck(reqId, true);
    });
  });

  // 18. Chat / Messaging Drawer Logic
  const toggleChatBtn = document.getElementById('toggleChatBtn');
  const floatingChatDrawer = document.getElementById('floatingChatDrawer');
  const closeChatDrawerBtn = document.getElementById('closeChatDrawerBtn');
  const chatMessagesScroll = document.getElementById('chatMessagesScroll');
  const chatMessageForm = document.getElementById('chatMessageForm');
  const chatMessageInput = document.getElementById('chatMessageInput');

  function setChatDrawerVisible(visible) {
    if (!floatingChatDrawer) return;
    floatingChatDrawer.classList.toggle('collapsed', !visible);
    if (toggleChatBtn) toggleChatBtn.classList.toggle('active', visible);
    if (visible && currentRequestId) {
      loadChatHistory(currentRequestId);
    }
  }

  if (toggleChatBtn) {
    toggleChatBtn.addEventListener('click', () => {
      const isCurrentlyCollapsed = floatingChatDrawer.classList.contains('collapsed');
      setChatDrawerVisible(isCurrentlyCollapsed);
    });
  }
  if (closeChatDrawerBtn) {
    closeChatDrawerBtn.addEventListener('click', () => setChatDrawerVisible(false));
  }

  function appendChatBubble(msg) {
    if (!chatMessagesScroll) return;
    const isOwn = String(msg.sender) === String(userId);
    const bubble = document.createElement('div');
    bubble.className = `chat-bubble ${isOwn ? 'own' : 'other'}`;
    const timeStr = msg.createdAt ? new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';

    bubble.innerHTML = `
      <div class="chat-text">${escapeHtml(msg.text || '')}</div>
      <span class="chat-time">${timeStr}</span>
    `;
    chatMessagesScroll.appendChild(bubble);
    chatMessagesScroll.scrollTop = chatMessagesScroll.scrollHeight;
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  async function loadChatHistory(reqId) {
    if (!reqId || !chatMessagesScroll) return;
    try {
      const res = await fetch(`/dashboard/requests/${reqId}/messages`);
      if (res.ok) {
        const data = await res.json();
        chatMessagesScroll.innerHTML = '';
        if (data.messages && data.messages.length > 0) {
          data.messages.forEach(m => appendChatBubble(m));
        } else {
          chatMessagesScroll.innerHTML = '<div style="text-align:center; color:#94a3b8; font-size:0.78rem; padding: 1rem;">No messages yet. Send a direct message below.</div>';
        }
      }
    } catch (e) {
      console.warn('Chat load error:', e);
    }
  }

  if (chatMessageForm && chatMessageInput) {
    chatMessageForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (typeof hideLoading === 'function') hideLoading();
      const txt = chatMessageInput.value.trim();
      if (!txt || !currentRequestId) return;

      // Optimistic append
      appendChatBubble({
        sender: userId,
        text: txt,
        createdAt: new Date()
      });
      chatMessageInput.value = '';

      try {
        await fetch(`/dashboard/requests/${currentRequestId}/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: txt })
        });
      } catch (err) {
        console.error('Send error:', err);
      }
    });

    const chatSendBtn = document.getElementById('chatSendBtn');
    if (chatSendBtn) {
      chatSendBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (typeof hideLoading === 'function') hideLoading();
      });
    }

    if (socket) {
      socket.on('newMessage', (payload) => {
        if (!payload || !payload.requestId || String(payload.requestId) !== String(currentRequestId)) return;
        if (String(payload.sender) === String(userId)) return; // Skip own optimistic message
        appendChatBubble(payload);
      });
    }
  }

  // 19. Stale Telemetry Timer (checks every 20 seconds)
  setInterval(() => {
    const now = Date.now();
    truckMarkers.forEach((t, reqId) => {
      const diff = now - t.lastUpdated;
      const wrap = document.getElementById(`marker-wrap-${reqId}`);
      if (wrap) {
        if (diff > 120000) { // > 2 minutes without GPS
          wrap.classList.add('is-stale');
          wrap.classList.remove('is-moving');
          const dot = wrap.querySelector('.plate-status-dot');
          if (dot) dot.className = 'plate-status-dot stale';
        }
      }
    });
    if (activeTruckData) {
      const activeObj = truckMarkers.get(activeTruckData.id);
      if (activeObj) updateInfoCardTelemetry(activeObj);
    }
  }, 20000);

})();
</script>