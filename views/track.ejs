<%
  const _req = typeof request !== 'undefined' && request ? request : null;
  const _activeList = typeof activeRequests !== 'undefined' && Array.isArray(activeRequests) ? activeRequests : (_req ? [_req] : []);
  const _user = typeof user !== 'undefined' && user ? user : {};
  const currentUserId = _user._id ? String(_user._id) : '';
  const currentRole = (_req && _req.shipper && String(_req.shipper._id) === currentUserId) ? 'shipper' : 'transporter';
%>

<div class="fleet-tracking-page">
  
  <!-- 1. TOP HEADER & TELEMETRY BAR -->
  <div class="fleet-top-bar">
    <div class="fleet-title-group">
      <a href="/dashboard/<%= currentRole === 'shipper' ? 'shipper' : 'transporter' %>" class="fleet-back-btn">
        <i class="fas fa-arrow-left"></i> Dashboard
      </a>
      <div class="fleet-title-text">
        <h1>
          <i class="fas fa-satellite-dish" style="color: var(--t2yd-saffron);"></i>
          Live Fleet Tracking
          <span class="fleet-desi-chip">PAN-INDIA 2D GPS</span>
        </h1>
      </div>
    </div>

    <!-- Live Telemetry Status -->
    <div class="fleet-telemetry-status">
      <div class="status-pill connecting" id="connectionStatus">
        <span class="pulse-dot"></span>
        <span class="status-label">Connecting GPS...</span>
      </div>

      <div class="gps-broadcasting-pill" id="gpsStreamPill" style="display: none;">
        <i class="fas fa-broadcast-tower fa-spin"></i>
        <span>Live GPS Transmitting</span>
      </div>
    </div>

    <!-- Quick Action Controls -->
    <div class="fleet-toolbar">
      <button type="button" class="tool-btn" id="recenterTruckBtn" title="Recenter on Active Truck">
        <i class="fas fa-crosshairs"></i> Recenter
      </button>

      <button type="button" class="tool-btn" id="fitRouteBoundsBtn" title="Fit Entire Route to Screen">
        <i class="fas fa-expand-arrows-alt"></i> Fit Route
      </button>

      <button type="button" class="tool-btn active" id="toggleFleetPanelBtn" title="Show/Hide Fleet List">
        <i class="fas fa-truck"></i> Fleet (<span class="badge-count" id="fleetBadgeCount"><%= _activeList.length %></span>)
      </button>

      <button type="button" class="tool-btn" id="toggleLegendBtn" title="Map Legend">
        <i class="fas fa-info-circle"></i> Legend
      </button>

      <% if (_req) { %>
      <button type="button" class="tool-btn" id="toggleChatBtn" title="Open Real-time Chat">
        <i class="fas fa-comments"></i> Chat
      </button>
      <% } %>

      <!-- Driver/Transporter GPS Sharing Toggle -->
      <% if (currentRole === 'transporter' && _req) { %>
      <button type="button" class="tool-btn share-stopped" id="liveShareToggleBtn">
        <i class="fas fa-location-arrow"></i> <span>Share My GPS</span>
      </button>
      <% } %>
    </div>
  </div>

  <!-- 2. MAIN MAP CANVAS & OVERLAYS -->
  <div class="map-stage-wrapper">
    
    <!-- Leaflet 2D Map Canvas -->
    <div id="map"></div>

    <!-- FLOATING ACTIVE FLEET PANEL (LEFT SIDE) -->
    <div class="floating-fleet-panel" id="floatingFleetPanel">
      <div class="fleet-panel-header">
        <h3><i class="fas fa-shield-alt" style="color: var(--t2yd-saffron);"></i> Authorized Fleet (<span id="panelFleetCount"><%= _activeList.length %></span>)</h3>
        <button type="button" class="panel-close-btn" id="closeFleetPanelBtn" title="Close Panel">&times;</button>
      </div>

      <div class="fleet-search-wrap">
        <input type="text" class="fleet-search-input" id="fleetSearchInput" placeholder="Filter by truck, driver, city...">
      </div>

      <div class="fleet-trucks-list" id="fleetTrucksList">
        <% if (_activeList.length === 0) { %>
          <div class="fleet-empty-state">
            <i class="fas fa-truck-loading"></i>
            <h4>No Active Fleet Tracking</h4>
            <p>You have no active shipments in progress right now. Live GPS tracking activates as soon as a transport bid is confirmed.</p>
            <a href="/dashboard/<%= currentRole === 'shipper' ? 'shipper' : 'transporter' %>" class="btn-card-primary" style="margin: 0 auto;">
              View Dashboard
            </a>
          </div>
        <% } else { %>
          <% _activeList.forEach(function(item, idx) { 
              const isSelected = _req && String(_req._id) === String(item._id);
              const lorryNum = item.lorry ? (item.lorry.vehicleNumber || 'Unassigned') : 'Unassigned';
              const driverName = item.transporter ? item.transporter.name : 'Assigned Transporter';
              const pCity = item.delivery ? (item.delivery.pickupLocation || 'Pickup Hub') : 'Pickup Hub';
              const dCity = item.delivery ? (item.delivery.dropLocation || 'Destination') : 'Destination';
              const hasGps = !!(item.transporterLocation && item.transporterLocation.lat);
          %>
          <div class="fleet-truck-card <%= isSelected ? 'active' : '' %>" data-request-id="<%= item._id %>" id="truck-card-<%= item._id %>">
            <div class="truck-card-top">
              <span class="truck-reg-number">
                <i class="fas fa-truck" style="color: var(--t2yd-saffron); font-size: 0.8rem;"></i>
                <%= lorryNum %>
              </span>
              <span class="truck-status-badge <%= hasGps ? 'live' : 'enroute' %>">
                <%= hasGps ? 'GPS Live' : (item.status === 'accepted' ? 'En Route' : item.status) %>
              </span>
            </div>
            <div class="truck-card-driver">
              <i class="fas fa-user-circle"></i> <%= driverName %>
            </div>
            <div class="truck-card-route">
              <span><%= pCity.split(',')[0] %></span>
              <i class="fas fa-arrow-right" style="font-size: 0.65rem; color: var(--t2yd-saffron);"></i>
              <span><%= dCity.split(',')[0] %></span>
            </div>
            <div class="truck-card-telemetry">
              <span>Goods: <%= item.delivery ? item.delivery.goodsType : 'General' %></span>
              <span><%= hasGps ? 'Updated' : 'Awaiting GPS' %></span>
            </div>
          </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- INTERACTIVE SELECTED TRUCK INFORMATION CARD (ANCHORED/BOTTOM) -->
    <div class="truck-info-card-dock" id="truckInfoCardDock" style="display: none;">
      <div class="truck-info-header">
        <div class="info-plate-group">
          <i class="fas fa-truck" style="color: #facc15;"></i>
          <span class="info-truck-plate" id="cardTruckPlate">MH-12-Q-4521</span>
          <span class="info-truck-type" id="cardTruckType">Tata 28T</span>
        </div>
        <button type="button" class="info-close-btn" id="closeInfoCardBtn">&times;</button>
      </div>

      <div class="truck-info-body">
        <div class="info-driver-row">
          <div class="driver-detail">
            <div class="driver-avatar-circle"><i class="fas fa-user"></i></div>
            <div>
              <div class="driver-name" id="cardDriverName">Driver Name</div>
              <div class="driver-role-label">Verified Transporter Partner</div>
            </div>
          </div>
          <a href="#" class="driver-call-btn" id="cardCallBtn">
            <i class="fas fa-phone-alt"></i> Call
          </a>
        </div>

        <div class="info-route-box">
          <div class="route-point pickup">
            <span class="point-dot"></span>
            <div><b>Pickup:</b> <span id="cardPickupText">Mumbai Hub</span></div>
          </div>
          <div class="route-point drop">
            <span class="point-dot"></span>
            <div><b>Drop:</b> <span id="cardDropText">Pune Unload</span></div>
          </div>
        </div>

        <div class="info-telemetry-grid">
          <div class="telemetry-cell">
            <div class="cell-lbl">Speed</div>
            <div class="cell-val" id="cardSpeedVal">Stationary</div>
          </div>
          <div class="telemetry-cell">
            <div class="cell-lbl">Last GPS</div>
            <div class="cell-val" id="cardLastGpsVal">Just now</div>
          </div>
          <div class="telemetry-cell">
            <div class="cell-lbl">Distance</div>
            <div class="cell-val" id="cardDistanceVal">-- km</div>
          </div>
        </div>

        <!-- Transporter Action Box: Mark Pickup & Photo Upload -->
        <% if (currentRole === 'transporter' && _req && _req.status === 'accepted') { %>
        <div class="mark-loaded-box" id="transporterMarkLoadedBox" style="<%= _req.loadedAt ? 'display:none;' : '' %>">
          <div style="font-size: 0.76rem; font-weight: 800; color: var(--t2yd-saffron);">
            <i class="fas fa-camera"></i> Goods Loading Verification
          </div>
          <div class="mark-loaded-actions">
            <input type="file" id="transporterPhotoInput" accept="image/*" style="display: none;">
            <button type="button" class="btn-card-outline" id="pickPhotoBtn">
              <i class="fas fa-camera"></i> Take Photo
            </button>
            <button type="button" class="btn-card-primary" id="markLoadedActionBtn">
              <i class="fas fa-check-circle"></i> Mark Pickup Loaded
            </button>
          </div>
          <div id="loadedPhotoPreviewBox" style="display: none; margin-top: 4px;">
            <img id="loadedPreviewImg" src="" alt="Loaded Photo" style="max-height: 80px; border-radius: 6px; border: 1px solid #fed7aa;">
          </div>
        </div>
        <% } %>

        <!-- Shipper Loaded Goods Photo Preview (if loaded) -->
        <div id="shipperPhotoBox" style="display: none; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 10px;">
          <div style="font-size: 0.72rem; font-weight: 800; color: #059669; margin-bottom: 4px;">
            <i class="fas fa-check-circle"></i> Transporter Uploaded Goods Photo
          </div>
          <img id="shipperGoodsPhotoImg" src="" alt="Loaded goods" style="max-height: 100px; border-radius: 6px;">
        </div>

        <div class="info-card-actions">
