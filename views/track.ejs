   6. MAP LEGEND POPUP (BOTTOM-RIGHT)
   ========================================================================== */
.floating-legend-box {
  position: absolute;
  bottom: 16px;
  right: 16px;
  background: var(--t2yd-card-bg);
  backdrop-filter: blur(12px);
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  padding: 8px 12px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  font-size: 0.72rem;
  z-index: 999;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #334155;
  font-weight: 700;
}

.legend-icon-badge {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.65rem;
}

/* ==========================================================================
   7. CHAT / MESSAGES DRAWER (RIGHT SIDE)
   ========================================================================== */
.floating-chat-drawer {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 330px;
  height: calc(100% - 28px);
  background: var(--t2yd-card-bg);
  backdrop-filter: blur(14px);
  border: 1.5px solid rgba(249, 115, 22, 0.3);
  border-radius: 18px;
  box-shadow: var(--t2yd-shadow);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  overflow: hidden;
}

.floating-chat-drawer.collapsed {
  transform: translateX(360px);
  opacity: 0;
  pointer-events: none;
}

.chat-drawer-header {
  padding: 0.85rem 1rem;
  background: linear-gradient(135deg, #ffffff 0%, #fff7ed 100%);
  border-bottom: 1px solid var(--t2yd-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-drawer-header h3 {
  font-size: 0.95rem;
  font-weight: 900;
  color: var(--t2yd-slate);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: 'Outfit', sans-serif;
}

.chat-messages-scroll {
  flex: 1;
  padding: 0.85rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.chat-bubble {
  max-width: 82%;
  padding: 8px 12px;
  border-radius: 12px;
  font-size: 0.8rem;
  line-height: 1.4;
  position: relative;
  word-break: break-word;
}

.chat-bubble.own {
  align-self: flex-end;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: #ffffff;
  border-bottom-right-radius: 2px;
}

.chat-bubble.other {
  align-self: flex-start;
  background: #f1f5f9;
  color: #0f172a;
  border-bottom-left-radius: 2px;
  border: 1px solid #e2e8f0;
}

.chat-time {
  font-size: 0.65rem;
  opacity: 0.75;
  display: block;
  text-align: right;
  margin-top: 2px;
}

.chat-input-bar {
  padding: 0.65rem 0.85rem;
  background: #ffffff;
  border-top: 1px solid #e2e8f0;
  display: flex;
  gap: 6px;
}

.chat-input-field {
  flex: 1;
  padding: 7px 10px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  font-size: 0.8rem;
  outline: none;
}
.chat-input-field:focus { border-color: var(--t2yd-saffron); }

.chat-send-btn {
  background: var(--t2yd-saffron);
  border: none;
  color: #ffffff;
  padding: 0 12px;
  border-radius: 8px;
  font-weight: 800;
  font-size: 0.8rem;
  cursor: pointer;
}

/* Responsive Breakpoints */
@media (max-width: 900px) {
  .floating-fleet-panel {
    width: 290px;
  }
  .floating-chat-drawer {
    width: 290px;
  }
}

