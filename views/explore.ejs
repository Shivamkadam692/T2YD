  const reelsFeedLoads = document.getElementById('reelsFeedLoads');
  const gridFeedTrucks = document.getElementById('gridFeedTrucks');
  const gridFeedLoads = document.getElementById('gridFeedLoads');
  
  const btnViewReels = document.getElementById('btnViewReels');
  const btnViewGrid = document.getElementById('btnViewGrid');
  const reelsStage = document.getElementById('reelsStage');
  const gridStage = document.getElementById('gridStage');
  
  const reelsContainer = document.getElementById('reelsContainer');
  const reelsProgressBar = document.getElementById('reelsProgressBar');
  const reelsCounterText = document.getElementById('reelsCounterText');
  const btnReelUp = document.getElementById('btnReelUp');
  const btnReelDown = document.getElementById('btnReelDown');
  const swipeUpCue = document.getElementById('swipeUpCue');
  const exploreSearchInput = document.getElementById('exploreSearchInput');
  const filterChipsContainer = document.getElementById('filterChipsContainer');
  const reelsToast = document.getElementById('reelsToast');
  const reelsToastText = document.getElementById('reelsToastText');

  let currentTab = '<%= initialTab || "trucks" %>';
  let currentView = '<%= initialView || "reels" %>';
  let activeSlideIndex = 0;
  let toastTimer = null;

  function showToast(text, iconClass = 'fa-check-circle') {
    if (!reelsToast || !reelsToastText) return;
    reelsToastText.textContent = text;
    const icon = reelsToast.querySelector('i');
    if (icon) icon.className = `fas ${iconClass}`;
    reelsToast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      reelsToast.classList.remove('show');
    }, 2500);
  }

  // 1. Category Switcher (Trucks vs Loads)
  function setCategory(tabName) {
    currentTab = tabName;
    const isTrucks = tabName === 'trucks';

    tabBtnTrucks.classList.toggle('active', isTrucks);
    tabBtnTrucks.setAttribute('aria-selected', isTrucks ? 'true' : 'false');
    tabBtnLoads.classList.toggle('active', !isTrucks);
    tabBtnLoads.setAttribute('aria-selected', !isTrucks ? 'true' : 'false');

    if (reelsFeedTrucks) reelsFeedTrucks.style.display = isTrucks ? '' : 'none';
    if (reelsFeedLoads) reelsFeedLoads.style.display = !isTrucks ? '' : 'none';
    if (gridFeedTrucks) gridFeedTrucks.style.display = isTrucks ? '' : 'none';
    if (gridFeedLoads) gridFeedLoads.style.display = !isTrucks ? '' : 'none';

    // Reset scroll to top
    if (reelsContainer) reelsContainer.scrollTop = 0;

    // Update URL without reload
    const url = new URL(window.location);
    url.searchParams.set('tab', tabName);
    window.history.replaceState({}, '', url);

    updateTelemetry();
  }

  tabBtnTrucks.addEventListener('click', () => setCategory('trucks'));
  tabBtnLoads.addEventListener('click', () => setCategory('loads'));

  // 2. View Mode Switcher (Reels vs Grid)
  function setViewMode(mode) {
    currentView = mode;
    const isReels = mode === 'reels';
    
    btnViewReels.classList.toggle('active', isReels);
    btnViewGrid.classList.toggle('active', !isReels);

    if (reelsStage) reelsStage.style.display = isReels ? 'block' : 'none';
    if (gridStage) gridStage.style.display = !isReels ? 'block' : 'none';

    try {
      localStorage.setItem('t2yd_explore_view_mode', mode);
    } catch (e) {}

    const url = new URL(window.location);
    url.searchParams.set('view', mode);
    window.history.replaceState({}, '', url);
  }

  btnViewReels.addEventListener('click', () => setViewMode('reels'));
  btnViewGrid.addEventListener('click', () => setViewMode('grid'));

  // Restore saved view preference if any
  try {
    const savedMode = localStorage.getItem('t2yd_explore_view_mode');
    if (savedMode && (savedMode === 'reels' || savedMode === 'grid') && !'<%= initialView %>') {
      setViewMode(savedMode);
    }
  } catch (e) {}

  // 3. Reels Scroll Snap & Active Slide Observer
  const activeFeedSelector = () => currentTab === 'trucks' ? '#reelsFeedTrucks' : '#reelsFeedLoads';
  
  function getVisibleSlides() {
    const parent = document.querySelector(activeFeedSelector());
    if (!parent) return [];
    return Array.from(parent.querySelectorAll('.reel-slide')).filter(s => s.style.display !== 'none');
  }

  function updateTelemetry() {
    const slides = getVisibleSlides();
    const total = slides.length;
    if (total === 0) {
      if (reelsCounterText) reelsCounterText.textContent = '0 Available';
      if (reelsProgressBar) reelsProgressBar.style.width = '0%';
      return;
    }

    const currentSlide = slides[activeSlideIndex] || slides[0];
    const displayNum = Math.min(activeSlideIndex + 1, total);
    const label = currentTab === 'trucks' ? 'Truck' : 'Load';
    
    if (reelsCounterText) {
      reelsCounterText.textContent = `${label} ${displayNum} of ${total}`;
    }
    if (reelsProgressBar) {
      reelsProgressBar.style.width = `${(displayNum / total) * 100}%`;
    }

    // Dismiss swipe cue on scroll past slide 0
    if (swipeUpCue && activeSlideIndex > 0) {
      swipeUpCue.style.opacity = '0';
      setTimeout(() => { if (swipeUpCue) swipeUpCue.style.display = 'none'; }, 400);
    }
  }

  // IntersectionObserver for active reel slide detection
  const observerOptions = {
    root: reelsContainer,
    threshold: 0.65
  };

  const reelObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const slide = entry.target;
        const slides = getVisibleSlides();
        const idx = slides.indexOf(slide);
        
        slides.forEach(s => s.classList.remove('is-active'));
        slide.classList.add('is-active');

        if (idx !== -1) {
          activeSlideIndex = idx;
          updateTelemetry();
        }
      }
    });
  }, observerOptions);

  function attachObservers() {
    reelObserver.disconnect();
    document.querySelectorAll('.reel-slide').forEach(s => reelObserver.observe(s));
  }
  attachObservers();

  // 4. Desktop Navigation Buttons (Up / Down)
  function scrollToSlide(direction) {
    const slides = getVisibleSlides();
    if (slides.length === 0) return;

    if (direction === 'down' && activeSlideIndex < slides.length - 1) {
      activeSlideIndex++;
    } else if (direction === 'up' && activeSlideIndex > 0) {
      activeSlideIndex--;
    }

    const targetSlide = slides[activeSlideIndex];
    if (targetSlide) {
      targetSlide.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  if (btnReelDown) btnReelDown.addEventListener('click', () => scrollToSlide('down'));
  if (btnReelUp) btnReelUp.addEventListener('click', () => scrollToSlide('up'));

  // 5. Keyboard Navigation (Arrow Keys / Page Up/Down)
  document.addEventListener('keydown', (e) => {
    if (currentView !== 'reels') return;
    if (e.target.matches('input, textarea, select')) return;

    if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === 'j') {
      e.preventDefault();
      scrollToSlide('down');
    } else if (e.key === 'ArrowUp' || e.key === 'PageUp' || e.key === 'k') {
      e.preventDefault();
      scrollToSlide('up');
    }
  });

  // 6. Live Search & Filter Engine
  function applyFilters() {
    const query = (exploreSearchInput ? exploreSearchInput.value : '').toLowerCase().trim();
    const activeChip = document.querySelector('.filter-chip.active');
    const chipFilter = activeChip ? activeChip.dataset.filter.toLowerCase() : 'all';

    let matchCountTrucks = 0;
    let matchCountLoads = 0;

    // Filter Truck Slides & Grid Cards
    document.querySelectorAll('#reelsFeedTrucks .reel-slide, #gridFeedTrucks .grid-card-item').forEach(el => {
      const text = el.dataset.searchText || '';
      const vType = el.dataset.vehicleType || '';
      const cap = parseFloat(el.dataset.capacity || '0');

      let matchesQuery = !query || text.includes(query);
      let matchesChip = true;

      if (chipFilter !== 'all') {
        if (chipFilter === '10+ tons') {
          matchesChip = cap >= 10;
        } else {
          matchesChip = text.includes(chipFilter) || vType.includes(chipFilter);
        }
      }

      const isMatch = matchesQuery && matchesChip;
      el.style.display = isMatch ? '' : 'none';
      if (isMatch && el.classList.contains('reel-slide')) matchCountTrucks++;
    });

    // Filter Load Slides & Grid Cards
    document.querySelectorAll('#reelsFeedLoads .reel-slide, #gridFeedLoads .grid-card-item').forEach(el => {
      const text = el.dataset.searchText || '';
      const weight = parseFloat(el.dataset.weight || '0');

      let matchesQuery = !query || text.includes(query);
      let matchesChip = true;

      if (chipFilter !== 'all') {
        if (chipFilter === '10+ tons') {
          matchesChip = weight >= 10000;
        } else {
          matchesChip = text.includes(chipFilter);
        }
      }

      const isMatch = matchesQuery && matchesChip;
      el.style.display = isMatch ? '' : 'none';
      if (isMatch && el.classList.contains('reel-slide')) matchCountLoads++;
    });

    // Update Counts
    const badgeTrucks = document.getElementById('badgeCountTrucks');
    const badgeLoads = document.getElementById('badgeCountLoads');
    const gridTrucks = document.getElementById('gridCountTrucks');
    const gridLoads = document.getElementById('gridCountLoads');

    if (badgeTrucks) badgeTrucks.textContent = matchCountTrucks;
    if (badgeLoads) badgeLoads.textContent = matchCountLoads;
    if (gridTrucks) gridTrucks.textContent = matchCountTrucks;
    if (gridLoads) gridLoads.textContent = matchCountLoads;

    activeSlideIndex = 0;
    updateTelemetry();
    attachObservers();
  }

  if (exploreSearchInput) {
    exploreSearchInput.addEventListener('input', applyFilters);
  }

  // Filter Chips Click
  if (filterChipsContainer) {
    filterChipsContainer.querySelectorAll('.filter-chip').forEach(chip => {
      chip.addEventListener('click', function() {
        filterChipsContainer.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        applyFilters();
      });
    });
  }

  // 7. Save / Bookmark System (localStorage)
  const SAVED_STORAGE_KEY = 't2yd_saved_listings';
  function getSavedListings() {
    try {
      return JSON.parse(localStorage.getItem(SAVED_STORAGE_KEY) || '[]');
    } catch (e) {
      return [];
    }
  }

  function toggleSaveListing(id, title, btn) {
    let saved = getSavedListings();
    const idx = saved.indexOf(id);
    const icon = btn.querySelector('i');

    if (idx > -1) {
      saved.splice(idx, 1);
      btn.classList.remove('active-saved');
      if (icon) icon.className = 'far fa-bookmark';
      showToast('Removed from saved listings', 'fa-trash-alt');
    } else {
      saved.push(id);
      btn.classList.add('active-saved');
      if (icon) icon.className = 'fas fa-bookmark';
      showToast('Listing saved to bookmarks! ⭐', 'fa-star');
    }

    try {
      localStorage.setItem(SAVED_STORAGE_KEY, JSON.stringify(saved));
    } catch (e) {}
  }

  // Initialize saved states
  const savedIds = getSavedListings();
  document.querySelectorAll('.btn-save-reel').forEach(btn => {
    const id = btn.dataset.id;
    if (savedIds.includes(id)) {
      btn.classList.add('active-saved');
      const icon = btn.querySelector('i');
      if (icon) icon.className = 'fas fa-bookmark';
    }
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleSaveListing(id, btn.dataset.title, btn);
    });
  });

  // 8. Share System
  document.querySelectorAll('.btn-share-reel').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const title = btn.dataset.title || 'T2YD Transport Listing';
      const url = window.location.origin + (btn.dataset.url || '');

      if (navigator.share) {
        try {
          await navigator.share({ title: `T2YD: ${title}`, text: 'Check out this verified transport listing on T2YD:', url });
          showToast('Shared successfully!', 'fa-share-alt');
          return;
        } catch (err) {
          // Fallback to clipboard
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        showToast('Link copied to clipboard! 📋', 'fa-copy');
      } catch (err) {
        showToast('Direct link: ' + url, 'fa-link');
      }
    });
  });

  // 9. Prevent accidental button clicks when dragging/swiping
  let touchStartY = 0;
  let isSwiping = false;

  reelsContainer.addEventListener('touchstart', (e) => {
    touchStartY = e.touches[0].clientY;
    isSwiping = false;
  }, { passive: true });

  reelsContainer.addEventListener('touchmove', (e) => {
    const diffY = Math.abs(e.touches[0].clientY - touchStartY);
    if (diffY > 10) isSwiping = true;
  }, { passive: true });

  document.querySelectorAll('.reel-slide a, .reel-slide button').forEach(el => {
    el.addEventListener('click', (e) => {
      if (isSwiping) {
        e.preventDefault();
        e.stopPropagation();
      }
    });
  });

  // 10. Initial Telemetry Update
  updateTelemetry();

})();

// Global helper for card "Read More" button
function toggleReadMore(btn, event) {
  if (event) event.stopPropagation();
  const parent = btn.closest('.truck-val');
  if (!parent) return;
  const shortAddr = parent.querySelector('.short-addr');
  const fullAddr = parent.querySelector('.full-addr');
  if (!shortAddr || !fullAddr) return;

  const isExpanded = fullAddr.style.display !== 'none';
  if (isExpanded) {
    fullAddr.style.display = 'none';
    shortAddr.style.display = 'inline';
    btn.textContent = 'Read More';
  } else {
    fullAddr.style.display = 'inline';
    shortAddr.style.display = 'none';
    btn.textContent = 'Show Less';
  }
}
</script>
