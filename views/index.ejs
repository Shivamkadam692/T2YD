}

.search-form button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(234, 88, 12, 0.4);
}

.quick-tags-row {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-top: 0.85rem;
  padding-top: 0.85rem;
  border-top: 1px dashed #fed7aa;
  align-items: center;
}

.quick-tags-label {
  font-size: 0.78rem;
  font-weight: 800;
  color: #64748b;
