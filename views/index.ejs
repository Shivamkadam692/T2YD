<!-- ==========================================
     HOW T2YD WORKS — INTERACTIVE CONTROLLER SCRIPT
     ========================================== -->
<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('how-it-works');
    if (!section) return;

    const cards = section.querySelectorAll('.how-step-card');
    const aiCta = document.getElementById('howItWorksAiCta');
    const aiCardIcon = document.getElementById('aiBotCardIcon');
    const floatingBotBtn = document.getElementById('chatBotButton');
    const floatingBotCue = document.getElementById('floatingBotCue');
    const roleButtons = section.querySelectorAll('.role-pill-btn');

    // 1. Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 2. Entrance Animation via IntersectionObserver
    if (!prefersReducedMotion && 'IntersectionObserver' in window) {
      const entranceObserver = new IntersectionObserver(function(entries, observer) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            cards.forEach(function(card, index) {
              setTimeout(function() {
                card.classList.add('card-revealed');
              }, index * 90);
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      entranceObserver.observe(section);
    } else {
      // Immediate reveal for reduced motion or legacy browsers
      cards.forEach(function(card) {
        card.classList.add('card-revealed');
      });
    }

    // 3. Highlight Current Step When Entering Viewport
    if ('IntersectionObserver' in window) {
      const stepObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('step-in-view');
            
            // If Step 6 (AI Bot) enters view, gently highlight the floating bot widget
            if (entry.target.id === 'step-card-ai' && floatingBotBtn) {
              floatingBotBtn.style.transform = 'scale(1.15)';
              floatingBotBtn.style.boxShadow = '0 0 0 8px rgba(249, 115, 22, 0.35), 0 8px 24px rgba(249, 115, 22, 0.45)';
              if (floatingBotCue) floatingBotCue.style.display = 'flex';
              
              setTimeout(function() {
                floatingBotBtn.style.transform = '';
                floatingBotBtn.style.boxShadow = '';
              }, 2000);
            }
          }
        });
      }, { threshold: 0.4 });

      cards.forEach(function(card) {
        stepObserver.observe(card);
      });
    }

    // 4. Final Step AI Bot Trigger Integration
    function handleAiBotTrigger(e) {
      if (e) e.preventDefault();

      if (floatingBotBtn) {
        // Trigger pulsing burst animation on existing floating bot
        floatingBotBtn.classList.remove('chat-bot-highlight-burst');
        void floatingBotBtn.offsetWidth; // Reflow to restart animation
        floatingBotBtn.classList.add('chat-bot-highlight-burst');

        // Reveal tooltip briefly
        const tooltip = floatingBotBtn.querySelector('.chat-bot-tooltip');
        if (tooltip) {
          tooltip.style.opacity = '1';
          tooltip.style.visibility = 'visible';
          tooltip.style.transform = 'translateY(0)';
        }

        // Trigger the existing chatbot button click handler
        setTimeout(function() {
          floatingBotBtn.click();
        }, 350);
      } else {
        // Direct navigation fallback
        window.location.href = '/chatbot';
      }
    }

    if (aiCta) {
      aiCta.addEventListener('click', handleAiBotTrigger);
    }

    if (aiCardIcon) {
      aiCardIcon.addEventListener('click', handleAiBotTrigger);
      aiCardIcon.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleAiBotTrigger(e);
        }
      });
    }

    // Step 6 hover cue: highlight floating bot button on hover
    const stepAiCard = document.getElementById('step-card-ai');
    if (stepAiCard && floatingBotBtn) {
      stepAiCard.addEventListener('mouseenter', function() {
        floatingBotBtn.style.transform = 'scale(1.18)';
        floatingBotBtn.style.boxShadow = '0 0 0 10px rgba(249, 115, 22, 0.4), 0 10px 25px rgba(249, 115, 22, 0.5)';
        if (floatingBotCue) floatingBotCue.style.display = 'flex';
      });

      stepAiCard.addEventListener('mouseleave', function() {
        floatingBotBtn.style.transform = '';
        floatingBotBtn.style.boxShadow = '';
      });
    }

    // 5. Interactive Role Persona Switcher
    roleButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        roleButtons.forEach(function(b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });

        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');

        const role = this.getAttribute('data-role');

        cards.forEach(function(card) {
          const stepNum = card.getAttribute('data-step');
          const roleTag = card.querySelector('.step-role-tag');

          if (role === 'shipper') {
            card.style.opacity = '1';
            if (stepNum === '2') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-boxes"></i> Post Goods Load';
            } else if (stepNum === '3') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-tags"></i> Receive Best Rates';
            } else if (stepNum === '4') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-check-double"></i> Book Truck Driver';
            } else if (stepNum === '5') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-map-marked-alt"></i> Live Gate Tracking';
            }
          } else if (role === 'transporter') {
            card.style.opacity = '1';
            if (stepNum === '2') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-search-location"></i> Find Load Returns';
            } else if (stepNum === '3') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-gavel"></i> Bid Your Rate/KM';
            } else if (stepNum === '4') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-truck-loading"></i> Assign Your Lorry';
            } else if (stepNum === '5') {
              if (roleTag) roleTag.innerHTML = '<i class="fas fa-route"></i> Turn-by-Turn GPS';
            }
          } else {
            // All Users (Default)
            if (stepNum === '1' && roleTag) roleTag.innerHTML = '<i class="fas fa-shield-alt"></i> KYC Verified';
            if (stepNum === '2' && roleTag) roleTag.innerHTML = '<i class="fas fa-map-pin"></i> Load & Fleet';
            if (stepNum === '3' && roleTag) roleTag.innerHTML = '<i class="fas fa-handshake"></i> Direct Bidding';
            if (stepNum === '4' && roleTag) roleTag.innerHTML = '<i class="fas fa-check-circle"></i> Confirmed Deal';
            if (stepNum === '5' && roleTag) roleTag.innerHTML = '<i class="fas fa-satellite-dish"></i> GPS Tracking';
            if (stepNum === '6' && roleTag) roleTag.innerHTML = '<i class="fas fa-sparkles"></i> 24/7 Smart Sahayak';
          }
        });
      });
    });

    // 6. Interactive Step 3 Miniature Bid Deck Selection
    const miniBids = section.querySelectorAll('.mini-bid-card');
    miniBids.forEach(function(bid) {
      bid.addEventListener('click', function() {
        miniBids.forEach(function(b) { b.classList.remove('highlight'); });
        this.classList.add('highlight');
      });
    });
  });
})();
</script>

