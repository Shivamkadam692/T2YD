}

.search-input-wrapper input {
  width: 100%;
  padding: 14px 16px 14px 44px;
  border-radius: 12px;
  border: 1.5px solid #fed7aa;
  font-size: 1rem;
  transition: all 0.2s ease;
  background: #fffaf5;
}

.search-input-wrapper input:focus {
  outline: none;
  border-color: #ea580c;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.15);
}

.search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
