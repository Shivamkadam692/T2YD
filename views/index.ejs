  transition: all 0.15s ease;
}

.quick-tag-btn:hover {
  background: #ea580c;
  color: #ffffff;
  border-color: #ea580c;
}

.section-title {
  font-size: 1.6rem;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 10px;
}

.section-title i {
  color: #ea580c;
}

