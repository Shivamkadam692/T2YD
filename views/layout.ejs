  <script src="/socket.io/socket.io.js"></script>
  
  <!-- Chat Bot Button Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const chatBotButton = document.getElementById('chatBotButton');
      
      if (chatBotButton) {
        const triggerChatBot = function() {
          window.location.href = '/chatbot';
        };
        chatBotButton.addEventListener('click', triggerChatBot);
        chatBotButton.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            triggerChatBot();
          }
        });
      }
    });
  </script>

  <!-- How T2YD Works Popup Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const popup = document.getElementById('howItWorksPopup');
      const closeBtn = document.getElementById('howPopupClose');
      const redirectBtn = document.getElementById('howPopupRedirectBtn');

      if (!popup) return;

      // Do not display popup if user is already on /how-it-works
      if (window.location.pathname === '/how-it-works') {
        return;
      }

      // Check user status: new guest vs first-time logged in vs returning old user
      const currentUserId = document.body.dataset.userId;
      if (currentUserId) {
        // Logged-in user: only show if first-time logged in user
        const hasVisitedBefore = localStorage.getItem('t2yd_user_has_visited_' + currentUserId);
        if (hasVisitedBefore === 'true') {
          // Returning/old user: DO NOT show popup
          return;
        }
        // First-time logged in user: mark as visited so they don't see it again
        localStorage.setItem('t2yd_user_has_visited_' + currentUserId, 'true');
      }

      // Check if popup was closed in this session
      const isDismissed = sessionStorage.getItem('t2yd_how_it_works_popup_closed');
      if (!isDismissed) {
        setTimeout(function() {
          popup.style.display = 'block';
        }, 1200);
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const card = popup.querySelector('.how-popup-card');
          if (card) {
            card.style.animation = 'popupSlideOut 0.3s ease forwards';
            setTimeout(function() {
              popup.style.display = 'none';
            }, 300);
          } else {
            popup.style.display = 'none';
          }
          sessionStorage.setItem('t2yd_how_it_works_popup_closed', 'true');
        });
      }

      if (redirectBtn) {
        redirectBtn.addEventListener('click', function() {
          sessionStorage.setItem('t2yd_how_it_works_popup_closed', 'true');
        });
      }
    });
  </script>
  
