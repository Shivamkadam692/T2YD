    }
  ];
  
  function resolveLoadingContext(pathname) {
    return loadingContextMap.find(ctx => ctx.match(pathname)) || defaultLoadingContext;
  }
  
  function applyLoadingContext(pathname) {
    const context = resolveLoadingContext(pathname);
    if (loadingHeadlineEl) {
      loadingHeadlineEl.textContent = context.headline;
    }
    if (progressLabelEl) {
      progressLabelEl.textContent = context.label;
    }
    if (progressStageEls.length) {
      progressStageEls.forEach((stageEl, index) => {
        stageEl.textContent = context.stages[index] || context.stages[context.stages.length - 1] || defaultLoadingContext.stages[index] || '';
      });
    }
  }
  
  // Initialize context for current page
  applyLoadingContext(window.location.pathname);
  
  // Show loading animation
  function showLoading(pathname = window.location.pathname) {
    if (loadingContainer) {
      applyLoadingContext(pathname);
      loadingContainer.classList.add('show');
    }
  }
  
  // Hide loading animation
  function hideLoading() {
    if (loadingContainer) {
      loadingContainer.classList.remove('show');
    }
  }
  
  // Show loading on page navigation
  document.addEventListener('click', function(e) {
    // If the click is anywhere inside a chat interface or message form, NEVER show loading and ensure any existing loader is hidden
    if (e.target.closest('#chatDrawer, .chat-drawer, #chatMessageForm, .chat-input-bar, .chat-messages-scroll, #chatContainer, #chatInputContainer, #msgForm, form.message-form, .no-loading, [data-no-loading], .chat-message, .chat-box, .chat-hints, .help-topics') ||
        e.target.closest('#sendBtn, #sendButton, .chat-send-btn, #chatSendBtn, .help-topic-btn, #clearChat, [data-no-loading]')) {
      hideLoading();
      return;
    }

    const target = e.target.closest('a:not([target]):not([download]), button[type="submit"]');
    if (target && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
      // Skip full page loading screen for chat messages, chat forms, and async forms
      if (
        target.closest('#msgForm, #chatContainer, #chatInputContainer, #chatDrawer, .chat-drawer, #chatMessageForm, .chat-input-bar, .no-loading, [data-no-loading], form.message-form') ||
        target.matches('#sendBtn, #sendButton, .chat-send-btn, #chatSendBtn, .help-topic-btn, #clearChat') ||
        target.classList.contains('chat-send-btn') ||
        target.classList.contains('no-loading')
      ) {
        hideLoading();
        return;
      }

      const href = target.getAttribute('href');
      if (href && !href.startsWith('#') && !href.startsWith('javascript:')) {
        try {
          const nextUrl = new URL(href, window.location.origin);
          if (nextUrl.origin === window.location.origin) {
            showLoading(nextUrl.pathname);
            return;
          }
        } catch (err) {
          // Ignore malformed URLs and fallback
        }
        showLoading();
      } else if (target.tagName === 'BUTTON' && target.type === 'submit') {
        const parentForm = target.closest('form');
        if (parentForm && (
          parentForm.classList.contains('no-loading') ||
          parentForm.hasAttribute('data-no-loading') ||
          parentForm.id === 'chatMessageForm' ||
          parentForm.classList.contains('chat-input-bar') ||
          parentForm.classList.contains('message-form')
        )) {
          hideLoading();
          return;
        }
        showLoading();
      }
    }
  });
  
  // Hide loading as soon as DOM is ready without waiting for heavy assets
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    hideLoading();
  } else {
    document.addEventListener('DOMContentLoaded', hideLoading);
  }
  window.addEventListener('load', hideLoading);
  window.addEventListener('pageshow', hideLoading);
  
  // Hide loading if still showing after 3 seconds (failsafe)
  setTimeout(hideLoading, 3000);
  </script>
