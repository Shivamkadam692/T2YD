<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Primary Meta Tags -->
  <title>T2YD | Goods Transport Platform - Connect Transporters & Shippers</title>
  <meta name="title" content="T2YD | Goods Transport Platform - Connect Transporters & Shippers">
  <meta name="description" content="T2YD is a modern goods transport platform connecting transporters and shippers across India. Manage deliveries, find lorries, bid on transport requests, and track shipments in real-time.">
  <meta name="keywords" content="goods transport, logistics, transporters, shippers, delivery management, lorry booking, transport platform, India logistics">
  <meta name="author" content="T2YD">
  <meta name="robots" content="index, follow">
  <meta name="language" content="English">
  <meta name="revisit-after" content="7 days">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'https://t2yd.com' %>">
  <meta property="og:title" content="T2YD | Goods Transport Platform">
  <meta property="og:description" content="Connect transporters and shippers across India. Manage deliveries, find lorries, and track shipments in real-time.">
  <meta property="og:image" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'https://t2yd.com' %>/og-image.jpg">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'https://t2yd.com' %>">
  <meta property="twitter:title" content="T2YD | Goods Transport Platform">
  <meta property="twitter:description" content="Connect transporters and shippers across India. Manage deliveries, find lorries, and track shipments in real-time.">
  <meta property="twitter:image" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'https://t2yd.com' %>/og-image.jpg">
  
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : '' %>">
  
  <!-- Stylesheets -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel="stylesheet" href="/style-modern.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/card-styles.css?v=<%= Date.now() %>">
  <!-- VOICE_DISABLED: <link rel="stylesheet" href="/css/voice-control.css"> -->
  
  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

<style>
/* Global Button & Action Overlap Prevention Across All Pages */
.request-actions,
.card-actions,
.truck-card-actions,
.lorry-actions,
.delivery-actions,
.form-actions,
.card-footer,
.track-actions,
.form-actions-bar,
.actions {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 0.65rem !important;
  align-items: center !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.request-actions form,
.card-footer form,
.lorry-actions form,
.delivery-actions form,
.track-actions form,
.card-actions form {
  display: inline-flex !important;
  margin: 0 !important;
  padding: 0 !important;
}

.btn,
.btn-primary,
.btn-outline,
.btn-success,
.btn-danger,
.btn-delete,
.btn-secondary,
.btn-edit,
.btn-truck-specs,
.btn-truck-book {
  white-space: nowrap !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 0.45rem !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  max-width: 100% !important;
  flex-shrink: 0 !important;
}

/* Dashboard pinned location badges */
.pinned-location-badge {
  word-break: break-word !important;
}

/* Navbar Brand Logo */
.logo {
  display: inline-flex !important;
  align-items: center !important;
  text-decoration: none !important;
  padding: 2px 0 !important;
  line-height: 0 !important;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

.navbar-logo-img {
  height: 52px !important;
  width: auto !important;
  max-width: 220px !important;
  object-fit: contain !important;
  display: block !important;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.08)) !important;
}

.logo:hover {
  transform: translateY(-1px) scale(1.02) !important;
}

.logo:hover .navbar-logo-img {
  filter: drop-shadow(0 4px 14px rgba(249, 115, 22, 0.35)) !important;
}

@media (max-width: 768px) {
  .navbar-logo-img {
    height: 42px !important;
    max-width: 175px !important;
  }

  /* Universal Mobile Card & Dashboard Action Button Grid Normalization */
  .request-actions,
  .card-actions,
  .card-footer,
  .track-actions,
  .delivery-actions,
  .lorry-actions {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)) !important;
    gap: 6px !important;
    width: 100% !important;
  }

  .request-actions form,
  .card-actions form,
  .card-footer form,
  .track-actions form,
  .delivery-actions form,
  .lorry-actions form {
    display: flex !important;
    width: 100% !important;
    margin: 0 !important;
  }

  .request-actions .btn,
  .card-actions .btn,
  .card-footer .btn,
  .track-actions .btn,
  .delivery-actions .btn,
  .lorry-actions .btn {
    width: 100% !important;
    height: 36px !important;
    min-height: 36px !important;
    max-height: 36px !important;
    padding: 0 0.5rem !important;
    font-size: 0.78rem !important;
    font-weight: 600 !important;
    border-radius: 8px !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    flex-shrink: 1 !important;
  }
}

@media (max-width: 480px) {
  .navbar-logo-img {
    height: 35px !important;
    max-width: 145px !important;
  }
}
</style>

</head>
<body<% if (user) { %> data-user-id="<%= user._id %>" data-user-role="<%= user.role %>"<% } %>>
  <!-- Modern Skeleton Loading Screen -->
  <div class="loading-container skeleton-screen" id="loadingContainer" role="status" aria-live="polite">
    <div class="skeleton-wrapper">
      <!-- Status pill -->
      <div class="skeleton-header-pill">
        <i class="fas fa-circle-notch fa-spin"></i>
        <span class="loading-headline">Loading T2YD Logistics...</span>
      </div>

      <!-- Skeleton Header Bar -->
      <div class="skeleton-bar skeleton-nav">
        <div class="skeleton-box skeleton-logo"></div>
        <div class="skeleton-nav-items">
          <div class="skeleton-box skeleton-nav-link"></div>
          <div class="skeleton-box skeleton-nav-link"></div>
          <div class="skeleton-box skeleton-nav-btn"></div>
        </div>
      </div>

      <!-- Skeleton Hero Banner -->
      <div class="skeleton-box skeleton-hero"></div>

      <!-- Skeleton Search Bar -->
      <div class="skeleton-box skeleton-search"></div>

      <!-- Skeleton Cards Grid -->
      <div class="skeleton-grid">
        <div class="skeleton-card">
          <div class="skeleton-card-header">
            <div class="skeleton-box skeleton-avatar"></div>
            <div class="skeleton-box skeleton-card-title"></div>
          </div>
          <div class="skeleton-card-body">
            <div class="skeleton-box skeleton-line w-80"></div>
            <div class="skeleton-box skeleton-line w-60"></div>
            <div class="skeleton-box skeleton-line w-40"></div>
          </div>
          <div class="skeleton-box skeleton-btn"></div>
        </div>
        <div class="skeleton-card">
          <div class="skeleton-card-header">
            <div class="skeleton-box skeleton-avatar"></div>
            <div class="skeleton-box skeleton-card-title"></div>
          </div>
          <div class="skeleton-card-body">
            <div class="skeleton-box skeleton-line w-80"></div>
            <div class="skeleton-box skeleton-line w-60"></div>
            <div class="skeleton-box skeleton-line w-40"></div>
          </div>
          <div class="skeleton-box skeleton-btn"></div>
        </div>
        <div class="skeleton-card">
          <div class="skeleton-card-header">
            <div class="skeleton-box skeleton-avatar"></div>
            <div class="skeleton-box skeleton-card-title"></div>
          </div>
          <div class="skeleton-card-body">
            <div class="skeleton-box skeleton-line w-80"></div>
            <div class="skeleton-box skeleton-line w-60"></div>
            <div class="skeleton-box skeleton-line w-40"></div>
          </div>
          <div class="skeleton-box skeleton-btn"></div>
        </div>
      </div>
    </div>
  </div>
  
  <header>
    <nav>
      <a href="/" class="logo" aria-label="T2YD - Transport to Your Destination">
        <img src="/images/t2yd-logo.png?v=<%= Date.now() %>" alt="T2YD - Transport to Your Destination" class="navbar-logo-img">
      </a>
      
      <div class="nav-right-group">
        <!-- Language Selector -->
        <div class="language-selector">
          <button class="language-btn" id="languageBtn" aria-label="Select Language">
            <i class="fas fa-globe"></i>
            <span id="currentLanguage">English</span>
            <i class="fas fa-chevron-down"></i>
          </button>
          <div class="language-dropdown" id="languageDropdown">
            <!-- Language options will be generated dynamically -->
          </div>
        </div>
        
        <ul class="nav-links" id="mobile-nav" tabindex="-1" aria-hidden="true" role="navigation" aria-label="Primary">
          <li class="mobile-menu-header">
            <span class="mobile-nav-title">
              <img src="/images/t2yd-logo.png?v=<%= Date.now() %>" alt="T2YD" style="height: 34px; width: auto; object-fit: contain; vertical-align: middle;">
            </span>
            <button class="close-mobile" aria-label="Close menu">✕</button>
          </li>
          <li><a href="/"><i class="fas fa-home"></i> Home</a></li>
          <li><a href="/how-it-works"><i class="fas fa-route"></i> How It Works</a></li>
          <li><a href="/explore"><i class="fas fa-play-circle" style="color: #ea580c;"></i> Explore Reels</a></li>
          <% if (user) { %>
            <% if (user.role === 'transporter') { %>
              <li><a href="/dashboard/transporter"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
              <li><a href="/lorries/add"><i class="fas fa-plus-circle"></i> Add Lorry</a></li>
              <li><a href="/lorries/my"><i class="fas fa-truck"></i> My Lorries</a></li>
            <% } else if (user.role === 'shipper') { %>
              <li><a href="/dashboard/shipper"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
              <li><a href="/deliveries/add"><i class="fas fa-plus-circle"></i> Add Delivery</a></li>
              <li><a href="/deliveries/my"><i class="fas fa-box"></i> My Deliveries</a></li>
            <% } %>
          <% } %>
          <% if (!user) { %>
            <li><a href="/auth/login" class="btn btn-outline"><i class="fas fa-sign-in-alt"></i> Login</a></li>
            <li><a href="/auth/signup" class="btn"><i class="fas fa-user-plus"></i> Signup</a></li>
          <% } else { %>
            <li class="user-greeting"><i class="fas fa-hand-wave"></i> Welcome, <span><%= user.name %></span> (<%= user.role%>) </li>
            <li>
              <div class="notification-container">
                <button class="notification-btn" id="notificationBtn" aria-label="Notifications">
                  <i class="fas fa-bell"></i>
                  <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                </button>
                <div class="notification-dropdown" id="notificationDropdown">
                  <div class="notification-header">
                    <h3><i class="fas fa-bell"></i> Notifications</h3>
                    <button class="mark-all-read" id="markAllRead"><i class="fas fa-check-double"></i> Mark all read</button>
                  </div>
                  <div class="notification-list" id="notificationList">
                    <div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading notifications...</div>
                  </div>
                  <div class="notification-footer">
                    <a href="/notifications/view" class="view-all"><i class="fas fa-external-link-alt"></i> View all notifications</a>
                  </div>
                </div>
              </div>
            </li>
            <li><a href="/profile"><i class="fas fa-user"></i> My Profile</a></li>
            <li><a href="/auth/logout" class="btn btn-outline"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
          <% } %>
        </ul>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>
  </header>
  <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>

  <main>
    <%- body %>
  </main>
  
  <!-- Voice Control Container -->
  <% if (user) { %>
  <!-- VOICE_DISABLED
  <div class="voice-control-container">
    <button class="voice-control-btn" id="voiceControlBtn" aria-label="Voice Control">
      <i class="fas fa-microphone"></i>
      <span>Voice Control</span>
    </button>
    <div class="voice-indicator" id="voiceIndicator"></div>
  </div>
  VOICE_DISABLED -->
  <% } %>

  <!-- Chat Bot Button -->
  <div class="chat-bot-button" id="chatBotButton" role="button" tabindex="0" aria-label="Ask T2YD AI Assistant" title="Need help? Ask T2YD AI">
    <i class="fas fa-robot"></i>
    <div class="chat-bot-tooltip">Ask T2YD AI anything!</div>
  </div>

  <!-- New Visitor "How T2YD Works" Floating Popup -->
  <div class="how-popup-container" id="howItWorksPopup" role="dialog" aria-labelledby="howPopupTitle" style="display: none;">
    <div class="how-popup-card">
      <button type="button" class="how-popup-close" id="howPopupClose" aria-label="Close notification">&times;</button>
      <div class="how-popup-icon-badge">
        <i class="fas fa-truck-moving"></i>
        <span class="how-popup-pulse-dot"></span>
      </div>
      <div class="how-popup-content">
        <span class="how-popup-tag">NEW TO T2YD?</span>
        <h4 id="howPopupTitle" class="how-popup-title">Check How T2YD Works!</h4>
        <p class="how-popup-desc">Learn how to book trucks, post loads &amp; track live in 5 easy steps.</p>
        <div class="how-popup-actions">
          <a href="/how-it-works" class="how-popup-btn" id="howPopupRedirectBtn">
            <span>Check How T2YD Works</span>
            <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
  /* New Visitor "How T2YD Works" Floating Popup */
  .how-popup-container {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 9998;
    max-width: 380px;
    width: calc(100% - 48px);
    pointer-events: auto;
  }

  .how-popup-card {
    background: #ffffff;
    border: 2px solid #ea580c;
    border-radius: 20px;
    box-shadow: 0 16px 36px -6px rgba(234, 88, 12, 0.35), 0 4px 14px rgba(0, 0, 0, 0.08);
    padding: 1.25rem 1.25rem 1.15rem 1.25rem;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    position: relative;
    overflow: hidden;
    animation: popupSlideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .how-popup-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(to right, #f97316, #facc15, #16a34a);
  }

  @keyframes popupSlideIn {
    0% { transform: translateY(40px) scale(0.92); opacity: 0; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }

  @keyframes popupSlideOut {
    0% { transform: translateY(0) scale(1); opacity: 1; }
    100% { transform: translateY(30px) scale(0.92); opacity: 0; }
  }

  .how-popup-close {
    position: absolute;
    top: 8px;
    right: 12px;
    background: transparent;
    border: none;
    font-size: 1.35rem;
    line-height: 1;
    color: #94a3b8;
    cursor: pointer;
    padding: 4px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .how-popup-close:hover {
    color: #ea580c;
    transform: scale(1.15);
  }

  .how-popup-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: linear-gradient(135deg, #fff7ed, #ffedd5);
    border: 1.5px solid #fed7aa;
    color: #ea580c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
    position: relative;
    box-shadow: 0 4px 10px rgba(249, 115, 22, 0.15);
  }

  .how-popup-pulse-dot {
    position: absolute;
    top: -3px;
    right: -3px;
    width: 10px;
    height: 10px;
    background: #16a34a;
    border: 2px solid #ffffff;
    border-radius: 50%;
    animation: pulseDot 1.5s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }

  .how-popup-content {
    flex: 1;
    min-width: 0;
  }

  .how-popup-tag {
    display: inline-block;
    background: #fff7ed;
    color: #ea580c;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.6px;
    padding: 2px 7px;
    border-radius: 999px;
    margin-bottom: 4px;
    border: 1px solid rgba(249, 115, 22, 0.3);
  }

  .how-popup-title {
    font-size: 1rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .how-popup-desc {
    font-size: 0.78rem;
    color: #64748b;
    margin: 0 0 10px 0;
    line-height: 1.45;
  }

  .how-popup-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: #ffffff !important;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(234, 88, 12, 0.3);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .how-popup-btn:hover {
    background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(234, 88, 12, 0.4);
  }

  @media (max-width: 768px) {
    /* Small, Compact How T2YD Works Visitor Popup on Mobile */
    .how-popup-container {
      bottom: 74px !important;
      left: 10px !important;
      right: 10px !important;
      width: auto !important;
      max-width: 330px !important;
      margin: 0 auto !important;
    }
    .how-popup-card {
      padding: 0.55rem 0.75rem !important;
      border-radius: 14px !important;
      gap: 0.5rem !important;
      border-width: 1.5px !important;
      box-shadow: 0 8px 24px rgba(234, 88, 12, 0.25), 0 3px 10px rgba(0, 0, 0, 0.08) !important;
    }
    .how-popup-icon-badge {
      width: 32px !important;
      height: 32px !important;
      font-size: 0.95rem !important;
      border-radius: 9px !important;
    }
    .how-popup-tag {
      font-size: 0.55rem !important;
      padding: 1px 5px !important;
      margin-bottom: 2px !important;
    }
    .how-popup-title {
      font-size: 0.82rem !important;
      font-weight: 800 !important;
      margin: 0 0 2px 0 !important;
      line-height: 1.2 !important;
    }
    .how-popup-desc {
      font-size: 0.68rem !important;
      margin: 0 0 5px 0 !important;
      line-height: 1.3 !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
    }
    .how-popup-btn {
      font-size: 0.7rem !important;
      padding: 4px 10px !important;
      border-radius: 7px !important;
      gap: 4px !important;
    }
    .how-popup-close {
      top: 4px !important;
      right: 6px !important;
      font-size: 1.15rem !important;
      padding: 2px !important;
    }

    /* Small, Compact Mobile Notifications Dropdown */
    .notification-dropdown {
      top: 66px !important;
      left: 10px !important;
      right: 10px !important;
      max-height: 48vh !important;
      border-radius: 14px !important;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18) !important;
    }
    .notification-header {
      padding: 0.45rem 0.75rem !important;
    }
    .notification-header h3 {
      font-size: 0.85rem !important;
    }
    .mark-all-read {
      font-size: 0.7rem !important;
    }
    .notification-list {
      max-height: 32vh !important;
    }
    .notification-item {
      padding: 0.45rem 0.65rem !important;
      font-size: 0.76rem !important;
    }
    .notification-footer {
      padding: 0.35rem 0.5rem !important;
    }
    .notification-footer .view-all {
      font-size: 0.72rem !important;
    }
  }
  </style>

