<script>
function toggleReadMore(btn, event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  const cell = btn.closest('.truck-cell');
  if (!cell) return;
  const shortEl = cell.querySelector('.short-addr');
  const fullEl = cell.querySelector('.full-addr');
  if (!shortEl || !fullEl) return;
  
  if (fullEl.style.display === 'none') {
    fullEl.style.display = 'inline';
    shortEl.style.display = 'none';
    btn.textContent = 'Read Less';
  } else {
    fullEl.style.display = 'none';
    shortEl.style.display = 'inline';
    btn.textContent = 'Read More';
  }
}
</script>

<%
function renderSearchAddrCell(label, text, isRight) {
  const addr = (text || 'N/A').trim();
  const isLong = addr.length > 25;
  const shortAddr = isLong ? addr.substring(0, 24) + '...' : addr;
%>
  <div class="truck-cell <%= isRight ? 'text-right' : '' %>">
    <span class="truck-label"><%= label %></span>
    <strong class="truck-val">
      <% if (isLong) { %>
        <span class="short-addr"><%= shortAddr %></span>
        <span class="full-addr" style="display: none;"><%= addr %></span>
        <button type="button" class="btn-read-more" onclick="toggleReadMore(this, event)">Read More</button>
      <% } else { %>
        <span><%= addr %></span>
      <% } %>
    </strong>
  </div>
<% } %>

<!-- ==========================================
     SEARCH BAR & HEADER
     ========================================== -->
<div class="search-results-top">
  <!-- Search input bar -->
  <div class="search-container">
    <form action="/search" method="get" class="search-form">
      <div class="search-input-wrapper">
        <i class="fas fa-search search-icon"></i>
        <input 
          type="text" 
          id="searchInput" 
          name="query" 
          value="<%= typeof query !== 'undefined' ? query : '' %>" 
          placeholder="Search by city, route, vehicle type (e.g., Open Body, Nanded, Mumbai)..." 
          required
        >
      </div>
      <button type="submit" class="search-btn-primary"><i class="fas fa-search"></i> Search</button>
      <% if (typeof query !== 'undefined' && query) { %>
        <a href="/search" class="btn btn-outline" style="white-space: nowrap;"><i class="fas fa-times"></i> Clear</a>
      <% } %>
    </form>

    <div class="quick-tags-row">
      <span class="quick-tags-label"><i class="fas fa-bolt"></i> Popular Searches:</span>
      <a href="/search?query=Open+Body" class="quick-tag-btn">🚛 Open Body</a>
      <a href="/search?query=Container" class="quick-tag-btn">📦 Container</a>
      <a href="/search?query=Trailer" class="quick-tag-btn">🚚 Trailer</a>
      <a href="/search?query=Mumbai" class="quick-tag-btn">📍 Mumbai</a>
      <a href="/search?query=Pune" class="quick-tag-btn">📍 Pune</a>
      <a href="/search?query=Delhi" class="quick-tag-btn">📍 Delhi</a>
      <a href="/search?query=Nanded" class="quick-tag-btn">📍 Nanded</a>
    </div>
  </div>

  <!-- Header with query and filter tabs -->
  <div class="search-header-bar">
    <div class="search-title-meta">
      <h1><i class="fas fa-truck-moving" style="color: #ea580c;"></i> Search Results</h1>
      <p>
        <% if (typeof query !== 'undefined' && query) { %>
          Found <strong><%= results ? results.length : 0 %></strong> result<%= (results && results.length === 1) ? '' : 's' %> for "<strong><%= query %></strong>"
        <% } else { %>
          Showing all available marketplace fleets & deliveries (<%= results ? results.length : 0 %> active)
        <% } %>
      </p>
    </div>

    <!-- Filter Tabs (All, Lorries, Deliveries) -->
    <div class="search-filter-pills">
      <a href="/search?query=<%= encodeURIComponent(typeof query !== 'undefined' ? query : '') %>&type=all" 
         class="filter-pill <%= (!filterType || filterType === 'all') ? 'active' : '' %>">
        <i class="fas fa-th-large"></i> All (<%= typeof totalCount !== 'undefined' ? totalCount : results.length %>)
      </a>
      <a href="/search?query=<%= encodeURIComponent(typeof query !== 'undefined' ? query : '') %>&type=lorry" 
         class="filter-pill <%= (filterType === 'lorry' || filterType === 'lorries') ? 'active' : '' %>">
        <i class="fas fa-truck"></i> Lorries (<%= typeof lorryCount !== 'undefined' ? lorryCount : results.filter(r => !r.goodsType).length %>)
      </a>
      <a href="/search?query=<%= encodeURIComponent(typeof query !== 'undefined' ? query : '') %>&type=delivery" 
         class="filter-pill <%= (filterType === 'delivery' || filterType === 'deliveries') ? 'active' : '' %>">
        <i class="fas fa-box"></i> Deliveries (<%= typeof deliveryCount !== 'undefined' ? deliveryCount : results.filter(r => r.goodsType).length %>)
      </a>
      <a href="/explore?query=<%= encodeURIComponent(typeof query !== 'undefined' ? query : '') %>&tab=<%= (filterType === 'delivery' || filterType === 'deliveries') ? 'loads' : 'trucks' %>" 
         class="filter-pill" style="background: linear-gradient(135deg, #ea580c, #f97316); color: #ffffff !important; border-color: #ea580c; font-weight: 800;">
        <i class="fas fa-compass"></i> Explore Feed 🧭
      </a>
    </div>
  </div>
</div>

<!-- Errors if any -->
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error" style="margin-bottom: 2rem;">
    <i class="fas fa-exclamation-circle"></i>
    <%= error %>
  </div>
<% } %>

<!-- ==========================================
     SEARCH RESULTS GRID (TRUCK CARDS)
     ========================================== -->
<% if (results && results.length > 0) { %>
  <div class="card-container">
    <% results.forEach(item => { %>
      <div class="truck-card">
        <!-- Top Orange Header -->
        <div class="truck-card-topbar">
          <div class="permit-tag"><%= item.goodsType ? 'EXPRESS FREIGHT' : 'NATIONAL PERMIT' %></div>
        </div>

        <!-- Slogans Bar -->
        <div class="truck-slogans-bar">
          <div class="slogan-col">
            <span class="slogan-green">धीरे चलो</span>
            <span class="slogan-orange">सुरक्षित चलो</span>
          </div>
          <div class="slogan-col slogan-center">
            <span class="slogan-emoji">☀️⛰️</span>
            <span class="slogan-dark">सफ़र लम्बा है</span>
            <span class="slogan-orange">मंज़िल जरूर मिलेगी</span>
          </div>
          <div class="slogan-col">
            <span class="slogan-red">रुकावट नहीं</span>
            <span class="slogan-dark">तजुर्बा है</span>
          </div>
        </div>

        <!-- Card Body Info -->
        <div class="truck-card-content">
          <!-- Row 1: Location with Read More -->
          <div class="truck-info-row location-row">
            <% renderSearchAddrCell(item.goodsType ? 'FROM' : 'BASE LOCATION', item.origin || item.pickupLocation || item.location || 'N/A', false); %>
            <div class="truck-stationed-badge">
              <i class="fas fa-<%= item.goodsType ? 'route' : 'crosshairs' %>"></i>
              <span><%= item.goodsType ? 'ROUTE' : 'STATIONED' %></span>
            </div>
            <% renderSearchAddrCell(item.goodsType ? 'DESTINATION' : 'VEHICLE PLATE', item.destination || item.dropLocation || item.vehicleNumber || 'AVAILABLE', true); %>
          </div>

          <!-- Row 2: Specs -->
          <div class="truck-info-row specs-row">
            <div class="truck-spec-card">
              <div class="spec-icon"><i class="fas fa-<%= item.goodsType ? 'box-open' : 'truck' %>"></i></div>
              <div class="spec-info">
                <span class="truck-label"><%= item.goodsType ? 'GOODS TYPE' : 'CHASSIS TYPE' %></span>
                <strong class="truck-val"><%= item.truckType || item.vehicleType || item.goodsType || 'Freight' %></strong>
              </div>
            </div>
            <div class="truck-spec-card">
              <div class="spec-icon"><i class="fas fa-weight-hanging"></i></div>
              <div class="spec-info">
                <span class="truck-label">CAPACITY</span>
                <strong class="truck-val"><%= item.capacity ? item.capacity + ' Tons' : (item.weight ? item.weight + ' kg' : 'N/A') %></strong>
              </div>
            </div>
          </div>

          <!-- Row 3: Owner -->
          <div class="truck-owner-row">
            <div class="owner-info">
              <span class="truck-label">POSTED BY</span>
              <strong class="truck-val owner-name"><%= item.ownerName || item.shipperName || 'Verified Partner' %></strong>
            </div>
            <div class="status-wrapper">
              <span class="truck-status-pill <%= item.status || 'available' %>">
                <%= (item.status || 'available').toUpperCase() %>
              </span>
            </div>
          </div>

          <!-- The Iconic Indian Truck Back Graphic -->
          <div class="truck-back-graphic">
            <div class="truck-horn-bar">
              <span class="flag">🇮🇳</span>
              <span class="horn-text">BLOW</span>
              <span class="lotus-flower">🌸</span>
              <span class="horn-text">HORN</span>
              <span class="flag">🇮🇳</span>
            </div>

            <div class="truck-dipper-bar">
              <span class="arrow-left">◀◀</span>
              <span class="dipper-text">USE DIPPER AT NIGHT</span>
              <span class="arrow-right">▶▶</span>
            </div>

            <div class="truck-bumper-bar">
              <div class="bumper-left">
                <div class="tail-lights">
                  <span class="light yellow"></span>
                  <span class="light red"></span>
                  <span class="light red"></span>
                </div>
                <span class="speed-badge">SPEED 40 KM</span>
              </div>
              <div class="bumper-plate-recess"></div>
              <div class="bumper-right">
                <div class="ind-plate">
                  <span class="ind-text">IND</span>
                  <span class="ind-num"><%= item.vehicleNumber || 'MH-T2YD-01' %></span>
                </div>
                <div class="tail-lights">
                  <span class="light red"></span>
                  <span class="light red"></span>
                  <span class="light yellow"></span>
                </div>
              </div>
            </div>

            <div class="truck-hazard-stripes"></div>

            <div class="truck-mudflaps-container">
              <div class="mudflap mudflap-left">
                <div class="mudflap-ribs">
                  <span class="flap-flower">🏵️</span>
                  <span class="flap-text">T2YD</span>
                </div>
              </div>
              <div class="mudflap mudflap-right">
                <div class="mudflap-ribs">
                  <span class="flap-flower">🏵️</span>
                  <span class="flap-text">BHARAT</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Action Buttons - NO OVERLAP -->
          <div class="truck-card-actions">
            <% if (item.goodsType) { %>
              <a href="/deliveries/<%= item._id %>" class="btn-truck-specs"><i class="fas fa-eye"></i> Specs</a>
              <% if (user && user.role === 'transporter') { %>
                <a href="/bid/<%= item._id %>" class="btn-truck-book"><i class="fas fa-handshake"></i> Book Delivery</a>
              <% } else { %>
                <a href="/deliveries/<%= item._id %>" class="btn-truck-book"><i class="fas fa-handshake"></i> View Delivery</a>
              <% } %>
            <% } else { %>
              <a href="/lorries/<%= item._id %>" class="btn-truck-specs"><i class="fas fa-eye"></i> Specs</a>
              <% if (user && user.role === 'shipper') { %>
                <form action="/dashboard/send-request" method="POST" style="margin: 0; width: 100%; display: flex;">
                  <input type="hidden" name="lorryId" value="<%= item._id %>" />
                  <button type="submit" class="btn-truck-book" style="width: 100%; border: none;"><i class="fas fa-handshake"></i> Book Truck</button>
                </form>
              <% } else { %>
                <a href="/lorries/<%= item._id %>" class="btn-truck-book"><i class="fas fa-handshake"></i> View Truck</a>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <!-- Rich Empty State with Clickable Suggestions -->
  <div class="empty-search-card">
    <div class="empty-search-icon">
      <i class="fas fa-search-location"></i>
    </div>
    <h3>No fleets or deliveries found <%= (typeof query !== 'undefined' && query) ? ('for "' + query + '"') : '' %></h3>
    <p>We couldn't find any lorries or delivery requests matching your search. Try checking your spelling or search using different keywords or chassis types below.</p>
    
    <div class="empty-suggestions">
      <a href="/search?query=Open+Body" class="quick-tag-btn">🚛 Open Body</a>
      <a href="/search?query=Container" class="quick-tag-btn">📦 Container</a>
      <a href="/search?query=Trailer" class="quick-tag-btn">🚚 Trailer</a>
      <a href="/search?query=Mumbai" class="quick-tag-btn">📍 Mumbai</a>
      <a href="/search?query=Pune" class="quick-tag-btn">📍 Pune</a>
      <a href="/search?query=Delhi" class="quick-tag-btn">📍 Delhi</a>
      <a href="/search?query=Nanded" class="quick-tag-btn">📍 Nanded</a>
    </div>

    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="/search" class="btn btn-primary" style="display: inline-flex;"><i class="fas fa-globe"></i> Browse All Available Fleets</a>
      <a href="/" class="btn btn-outline" style="display: inline-flex;"><i class="fas fa-arrow-left"></i> Back to Home</a>
    </div>
  </div>
<% } %>
